.knowledge-hero{padding:36rpx;border:1rpx solid rgba(211,145,255,.32);border-radius:28rpx;color:#fff;background:radial-gradient(circle at 90% 10%,rgba(99,215,255,.2),transparent 30%),linear-gradient(145deg,#6333a5,#224f91);box-shadow:0 20rpx 52rpx rgba(55,20,116,.32)}
.hero-kicker{color:#d9a7ff;font-size:18rpx;letter-spacing:3rpx}.hero-title{margin-top:10rpx;color:#fff;font-size:40rpx;font-weight:700}.hero-desc{margin-top:9rpx;color:rgba(255,255,255,.72);font-size:21rpx}
.search-box{display:flex;align-items:center;margin-top:22rpx;padding:0 22rpx;border:1rpx solid rgba(211,145,255,.28);border-radius:18rpx;background:#171231}.search-icon{margin-right:14rpx;color:#d391ff;font-size:36rpx}.search-box input{flex:1;height:88rpx;color:#fff;background:transparent;font-weight:600}.search-placeholder{color:#aaa2bf}
.category-scroll{margin:20rpx 0;white-space:nowrap}.category-row{display:inline-flex;gap:12rpx}.category{padding:12rpx 22rpx;border:1rpx solid rgba(201,130,255,.14);border-radius:999rpx;color:#b7afca;background:#211943}.category.active{border-color:#d391ff;color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd)}
.source-note{margin-bottom:18rpx;padding:20rpx;border-left:6rpx solid #a15be8;border-radius:16rpx;color:#d8cfe8;background:#2a2048;line-height:1.6}
.ask-assistant{display:flex;align-items:center;margin-bottom:18rpx;padding:20rpx;border:1rpx solid rgba(123,228,255,.24);border-radius:20rpx;background:linear-gradient(135deg,rgba(102,49,165,.7),rgba(34,79,145,.7))}.ask-mark{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;margin-right:16rpx;border-radius:18rpx;color:#fff;background:linear-gradient(145deg,#c35ef0,#267dd5);font-size:20rpx;font-weight:800}.ask-copy{flex:1}.ask-title{color:#fff;font-weight:700}.ask-desc{margin-top:4rpx;color:#cfc4df;font-size:18rpx}.ask-arrow{color:#fff;font-size:38rpx}
.knowledge-card{margin-bottom:16rpx;padding:24rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:22rpx;background:#1b153b}.card-top,.source-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.category-tag{padding:6rpx 13rpx;border-radius:999rpx;color:#e4c1ff;background:#302255;font-size:19rpx}.updated{color:#9f97b6;font-size:18rpx}.item-title{margin-top:16rpx;color:#fff;font-size:30rpx;font-weight:700}.item-summary{margin-top:10rpx;color:#c8c0d8;line-height:1.65}.expand-text{margin-top:15rpx;color:#7be4ff;font-weight:700;text-align:right}
.detail{margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid rgba(201,130,255,.16)}.paragraph{margin-bottom:14rpx;color:#e2dced;line-height:1.8}.source-row{margin-top:22rpx;padding:18rpx;border-radius:16rpx;background:#251d49}.source-copy{flex:1;min-width:0}.source-label{color:#9f97b6;font-size:18rpx}.source-name{margin-top:5rpx;color:#f2efff;font-weight:700}.copy-button{flex:0 0 auto;margin:0;padding:0 18rpx;border-radius:999rpx;color:#fff;background:#7546ba;font-size:20rpx;line-height:64rpx}
