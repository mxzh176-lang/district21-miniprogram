<view class="page">
  <view class="knowledge-hero">
    <view class="hero-kicker">KNOWLEDGE BASE</view>
    <view class="hero-title">中国狮子联会知识库</view>
    <view class="hero-desc">官方资料索引、服务知识与协作区内部规范</view>
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input value="{{keyword}}" bindinput="search" placeholder-class="search-placeholder" placeholder="搜索章程、制度、服务或关键词"
      placeholder-style="color:#aaa2bf;" />
  </view>

  <scroll-view scroll-x class="category-scroll">
    <view class="category-row">
      <view wx:for="{{categories}}" wx:key="*this"
        class="category {{selectedCategory === item ? 'active' : ''}}"
        data-category="{{item}}" bindtap="selectCategory">{{item}}</view>
    </view>
  </scroll-view>

  <view class="source-note">官方资料均保留来源链接和更新时间；制度执行以官方现行文件为准。</view>
  <view class="ask-assistant" bindtap="goAssistant">
    <view class="ask-mark">AI</view>
    <view class="ask-copy"><view class="ask-title">向 AI 助手提问</view><view class="ask-desc">根据知识库快速查找答案和来源</view></view>
    <view class="ask-arrow">›</view>
  </view>

  <view wx:if="{{filteredItems.length}}">
    <view class="knowledge-card" wx:for="{{filteredItems}}" wx:key="_id">
      <view data-id="{{item._id}}" bindtap="toggleItem">
        <view class="card-top">
          <text class="category-tag">{{item.category}}</text>
          <text class="updated">{{item.updatedAt}}</text>
        </view>
        <view class="item-title">{{item.title}}</view>
        <view class="item-summary">{{item.summary}}</view>
        <view class="expand-text">{{expandedId === item._id ? '收起内容' : '查看内容'}}</view>
      </view>
      <view wx:if="{{expandedId === item._id}}" class="detail">
        <view class="paragraph" wx:for="{{item.content}}" wx:key="*this">{{index + 1}}. {{item}}</view>
        <view class="source-row">
          <view class="source-copy">
            <view class="source-label">资料来源</view>
            <view class="source-name">{{item.sourceName}}</view>
          </view>
          <button wx:if="{{item.sourceUrl}}" class="copy-button" data-url="{{item.sourceUrl}}"
            catchtap="copySource">复制官方链接</button>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="empty">没有找到相关资料，请更换关键词或分类。</view>
</view>
