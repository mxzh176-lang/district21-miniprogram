<view class="page">
  <view class="scope-card">
    <view class="scope-badge">{{id ? '编辑' : '新建'}}</view>
    <text class="scope-title">{{organizationName}}</text>
    <text class="scope-subtitle">{{categoryName}} · 单条内部记录</text>
    <view class="scope-progress">
      <view class="progress-item active"><text>1</text><view>填写</view></view>
      <view class="progress-line"></view>
      <view class="progress-item"><text>2</text><view>内容</view></view>
      <view class="progress-line"></view>
      <view class="progress-item"><text>3</text><view>保存</view></view>
    </view>
  </view>

  <view class="permission-tip" wx:if="{{canEdit}}">
    <view class="tip-icon">✓</view>
    <view>
      <view class="tip-title">当前账号是本栏目负责人</view>
      <view class="tip-text">事件自动关联当前服务队、栏目和录入账号，不会获得管理员权限。</view>
    </view>
  </view>
  <view class="permission-tip denied" wx:else>
    <view class="tip-icon">!</view>
    <view>当前账号没有该档案的编辑权限。</view>
  </view>

  <block wx:if="{{canEdit}}">
    <view class="form-section">
      <view class="section-heading">
        <view class="section-number">01</view>
        <view>
          <view class="section-title">基本信息</view>
          <view class="section-desc">先填写时间和记录名称</view>
        </view>
      </view>

      <view class="field">
        <view class="field-head">
          <text class="label">记录日期</text>
          <text class="required">必填</text>
        </view>
        <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
          <view class="picker">
            <text>{{form.date}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <view class="field-head">
          <text class="label">记录标题</text>
          <text class="required">必填</text>
        </view>
        <input class="input wide-input" style="color:#000000;-webkit-text-fill-color:#000000;font-weight:700;opacity:1;"
          cursor-color="#7447c8" value="{{form.title}}" data-field="title" bindinput="onInput"
          placeholder-class="form-placeholder" placeholder-style="color:#626d82;font-weight:500;"
          placeholder="{{formCopy.titlePlaceholder}}" />
        <view class="field-help">标题建议控制在 10 至 30 个字，方便历史事件列表展示。</view>
      </view>

      <view class="field">
        <view class="field-head"><text class="label">地点</text><text class="required">必填</text></view>
        <input class="input wide-input" style="color:#000000;-webkit-text-fill-color:#000000;font-weight:700;opacity:1;"
          cursor-color="#7447c8" value="{{form.location}}" data-field="location" bindinput="onInput"
          placeholder-class="form-placeholder" placeholder-style="color:#626d82;font-weight:500;"
          placeholder="请输入事件地点" />
      </view>

      <view class="field">
        <view class="field-head"><text class="label">参与狮友</text><text class="required">必选</text></view>
        <view class="participant-summary">
          <view>
            <view class="participant-total">{{form.participantCount || 0}} 人</view>
            <view class="participant-help">点击服务队展开，从成员名单中勾选参与狮友</view>
          </view>
        </view>
        <view wx:if="{{legacyParticipantNote}}" class="legacy-participant-note">{{legacyParticipantNote}}</view>
        <view class="participant-team participant-team-{{item.tone}}" wx:for="{{participantTeams}}" wx:key="id">
          <view class="participant-team-head" data-team-id="{{item.id}}" bindtap="toggleParticipantTeam">
            <view>
              <view class="participant-team-name">{{item.name}}</view>
              <view class="participant-team-count">已选 {{item.selectedCount}} / {{item.members.length}}</view>
            </view>
            <view class="participant-team-arrow">{{item.expanded ? '收起' : '展开'}} ›</view>
          </view>
          <view class="participant-member-grid" wx:if="{{item.expanded}}">
            <view
              class="participant-member {{member.checked ? 'checked' : ''}}"
              wx:for="{{item.members}}"
              wx:for-item="member"
              wx:key="id"
              data-id="{{member.id}}"
              bindtap="toggleParticipant"
            >
              <view class="participant-checkbox">{{member.checked ? '✓' : ''}}</view>
              <text>{{member.name}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="form-section template-section">
      <view class="section-heading">
        <view class="section-number template-number">模</view>
        <view>
          <view class="section-title">分类记录模板</view>
          <view class="section-desc">根据档案类别填充固定格式，内容仍由负责人核对</view>
        </view>
      </view>

      <view class="field">
        <text class="label">{{formCopy.keywordLabel}}</text>
        <input class="input wide-input" style="color:#000000;-webkit-text-fill-color:#000000;font-weight:700;opacity:1;"
          cursor-color="#7447c8" value="{{form.keywords}}" data-field="keywords" bindinput="onInput"
          placeholder-class="form-placeholder" placeholder-style="color:#626d82;font-weight:500;"
          placeholder="{{formCopy.keywordPlaceholder}}" />
        <view class="keyword-examples">
          <text>示例：</text>
          <text class="keyword-chip" wx:for="{{formCopy.keywordExamples}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <button class="template-button" bindtap="applyTemplate">
        <text class="template-button-icon">模</text>
        <text>套用分类记录模板</text>
      </button>
      <view class="template-note success" wx:if="{{templateApplied}}">
        模板已填充，请继续检查和修改下方内容。
      </view>
    </view>

    <view class="form-section">
      <view class="section-heading">
        <view class="section-number">02</view>
        <view>
          <view class="section-title">内容记录</view>
          <view class="section-desc">摘要用于列表，详情用于完整档案</view>
        </view>
      </view>

      <view class="field">
        <text class="label">内容摘要</text>
        <textarea class="textarea short" style="color:#000000;-webkit-text-fill-color:#000000;font-weight:700;opacity:1;"
          cursor-color="#7447c8" value="{{form.summary}}" data-field="summary" bindinput="onInput"
          placeholder-class="form-placeholder" placeholder-style="color:#626d82;font-weight:500;"
          placeholder="请输入简短摘要，用于历史事件列表展示" />
      </view>

      <view class="field">
        <view class="field-head">
          <text class="label">详细记录</text>
          <text class="required">必填</text>
        </view>
        <textarea class="textarea" style="color:#000000;-webkit-text-fill-color:#000000;font-weight:700;opacity:1;"
          cursor-color="#7447c8" value="{{form.content}}" data-field="content" bindinput="onInput"
          placeholder-class="form-placeholder" placeholder-style="color:#626d82;font-weight:500;"
          placeholder="{{formCopy.detailPlaceholder}}" />
      </view>
    </view>

    <view class="form-section">
      <view class="section-heading">
        <view class="section-number">03</view>
        <view>
          <view class="section-title">图片与关联信息</view>
          <view class="section-desc">最多上传 9 张与本条内部档案相关的图片</view>
        </view>
      </view>

      <view class="photo-upload" wx:if="{{canUpload}}" bindtap="choosePhotos">
        <view class="upload-icon">＋</view>
        <view class="upload-copy">
          <view class="upload-title">{{form.photoCount ? '继续添加附件' : formCopy.photoTitle}}</view>
          <view class="upload-desc">{{form.photoCount ? '已选择 ' + form.photoCount + ' 张' : formCopy.photoDescription}}</view>
        </view>
        <view class="upload-arrow">›</view>
      </view>

      <view class="photo-preview" wx:if="{{form.photos.length}}">
        <view class="preview-item" wx:for="{{form.photos}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" />
          <view class="photo-index">{{index + 1}}</view>
          <view class="remove-photo" wx:if="{{canUpload}}" data-index="{{index}}" catchtap="removePhoto">×</view>
        </view>
      </view>

      <view class="uploader-row">
        <view>
          <view class="uploader-label">录入人</view>
          <view class="uploader-desc">自动记录当前操作账号</view>
        </view>
        <input class="uploader-name" style="color:#5b6476;-webkit-text-fill-color:#5b6476;font-weight:700;opacity:1;"
          value="{{form.uploadedBy}}" disabled />
      </view>
    </view>

    <view class="form-section honor-section" wx:if="{{honorEligible}}">
      <view class="section-heading">
        <view class="section-number honor-number">荣</view>
        <view>
          <view class="section-title">荣誉申报</view>
          <view class="section-desc">提交保存前选择；申报后进入待直属确认，不直接进入荣誉榜</view>
        </view>
      </view>

      <view class="honor-options">
        <view
          class="honor-option {{honorRequestedLevel === item.value ? 'active' : ''}}"
          wx:for="{{honorOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="onHonorChange"
        >
          <view class="honor-radio">{{honorRequestedLevel === item.value ? '●' : '○'}}</view>
          <view>
            <view class="honor-label">{{item.label}}</view>
            <view class="honor-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>

      <view class="confirm-tip" wx:if="{{honorRequestedLevel !== 'none'}}">
        直属确认岗位：{{confirmPositionName || '直属上级'}}。确认授予后进入荣誉主席核准。
      </view>
    </view>
  </block>

  <view class="footer-actions" wx:if="{{canEdit}}">
    <button class="publish-button" bindtap="saveEvent">保存事件</button>
  </view>
</view>
