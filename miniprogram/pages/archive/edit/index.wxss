.page{min-height:100vh;padding:24rpx 24rpx 190rpx;background:linear-gradient(180deg,#e9edf7 0,#f5f7fb 360rpx,#eef2f8 100%);box-sizing:border-box}
.scope-card{position:relative;overflow:hidden;padding:34rpx 34rpx 30rpx;border-radius:30rpx;color:#fff;background:radial-gradient(circle at 92% 0,rgba(107,225,255,.3),transparent 34%),linear-gradient(135deg,#693eb0,#285a9e);box-shadow:0 18rpx 44rpx rgba(52,48,112,.24)}
.scope-card:after{position:absolute;right:-60rpx;bottom:-90rpx;width:250rpx;height:250rpx;border:1rpx solid rgba(255,255,255,.12);border-radius:50%;content:""}
.scope-badge{display:inline-block;padding:6rpx 16rpx;border-radius:999rpx;color:#fff;background:rgba(255,255,255,.16);font-size:19rpx;font-weight:700}
.scope-title,.scope-subtitle{display:block;position:relative;z-index:1}.scope-title{margin-top:18rpx;color:#fff;font-size:40rpx;font-weight:800;text-shadow:0 2rpx 10rpx rgba(0,0,0,.2)}.scope-subtitle{margin-top:9rpx;color:#e9e1ff;font-size:22rpx}
.scope-progress{display:flex;align-items:flex-start;margin-top:28rpx}.progress-item{color:rgba(255,255,255,.58);font-size:18rpx;text-align:center}.progress-item text{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;margin:auto;border:1rpx solid rgba(255,255,255,.35);border-radius:50%;font-weight:700}.progress-item view{margin-top:6rpx}.progress-item.active{color:#fff}.progress-item.active text{color:#5d399d;background:#fff}.progress-line{flex:1;height:2rpx;margin:22rpx 10rpx 0;background:rgba(255,255,255,.25)}
.permission-tip{display:flex;align-items:flex-start;gap:17rpx;margin:20rpx 0;padding:21rpx 23rpx;border:1rpx solid #d9d3ed;border-radius:20rpx;color:#4b4660;background:#fff;line-height:1.55;box-shadow:0 10rpx 28rpx rgba(43,50,85,.07)}.tip-icon{display:flex;flex:0 0 45rpx;align-items:center;justify-content:center;width:45rpx;height:45rpx;border-radius:50%;color:#fff;background:#7150b6;font-weight:800}.tip-title{color:#28243a;font-weight:800}.tip-text{margin-top:4rpx;color:#696477;font-size:20rpx}.permission-tip.denied{border-color:#f0c9cf;color:#8d3545;background:#fff5f6}.permission-tip.denied .tip-icon{background:#d65e70}
.photo-reminder{display:flex;align-items:center;gap:16rpx;margin:20rpx 0;padding:24rpx;border:2rpx solid #f0a43c;border-radius:22rpx;background:linear-gradient(135deg,#fff7df,#fff);box-shadow:0 12rpx 28rpx rgba(206,126,20,.14)}.photo-reminder-icon{font-size:42rpx}.photo-reminder-copy{flex:1}.photo-reminder-title{color:#713d00;font-size:27rpx;font-weight:900}.photo-reminder-desc{margin-top:5rpx;color:#8a642f;font-size:19rpx}.photo-reminder-action{color:#a85400;font-size:21rpx;font-weight:900;white-space:nowrap}
.form-section{margin-top:18rpx;padding:28rpx;border:1rpx solid #dfe4ee;border-radius:27rpx;background:#fff;box-shadow:0 14rpx 36rpx rgba(43,50,85,.08)}.section-heading{display:flex;align-items:center;margin-bottom:28rpx;padding-bottom:20rpx;border-bottom:1rpx solid #edf0f5}.section-number{display:flex;flex:0 0 68rpx;align-items:center;justify-content:center;width:68rpx;height:68rpx;margin-right:17rpx;border-radius:20rpx;color:#5f3ea4;background:#eee8fa;font-size:22rpx;font-weight:800}.section-number.template-number{color:#fff;background:linear-gradient(145deg,#9f58df,#387bd0)}.section-title{margin:0;color:#17233f;font-size:30rpx;font-weight:800}.section-desc{margin-top:4rpx;color:#7b8495;font-size:19rpx}
.field+.field{margin-top:28rpx}.field-head{display:flex;align-items:center;justify-content:space-between}.label{display:block;margin-bottom:12rpx;color:#17233f;font-size:26rpx;font-weight:800}.required{margin-bottom:12rpx;color:#9b5de5;font-size:18rpx}.input,.picker,.textarea{width:100%;padding:22rpx 24rpx;border:2rpx solid #cbd3e1;border-radius:17rpx;color:#000!important;-webkit-text-fill-color:#000!important;background:#f5f7fb!important;box-sizing:border-box;font-size:28rpx;font-weight:700;line-height:1.55;opacity:1}.wide-input{min-height:96rpx;padding-right:27rpx;padding-left:27rpx;font-size:29rpx}.picker{display:flex;align-items:center;justify-content:space-between}.picker-arrow{color:#7e61b9;font-size:38rpx}.input:focus,.textarea:focus{border-color:#8054cc;background:#fff!important;box-shadow:0 0 0 5rpx rgba(128,84,204,.12)}.textarea{min-height:250rpx}.textarea.short{min-height:145rpx}.form-placeholder{color:#626d82!important;font-weight:500}.field-help{margin-top:9rpx;color:#8a93a3;font-size:18rpx}
.inline-field-row{display:flex;align-items:flex-start;gap:16rpx}.inline-field-row .inline-field{flex:1;min-width:0;margin-top:0}.compact-picker{min-height:92rpx;padding:18rpx 16rpx;font-size:23rpx}.compact-picker text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.archive-directory-section{border-color:#d8e2f7;background:linear-gradient(180deg,#fff 0,#f8fbff 100%)}.category-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:24rpx}.category-card{position:relative;display:flex;flex-direction:column;min-height:180rpx;padding:22rpx;border:2rpx solid #e4e8f1;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 24rpx rgba(43,50,85,.06);box-sizing:border-box}.category-card.active{border-color:#397bd0;background:#eff6ff;box-shadow:0 14rpx 28rpx rgba(57,123,208,.13)}.category-card.restricted{background:#f9f7ff}.category-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}.category-name{flex:1;min-width:0;color:#17233f;font-size:26rpx;font-weight:900;line-height:1.25}.category-person{overflow:hidden;max-width:150rpx;color:#1456f0;font-size:28rpx;font-weight:900;text-align:right;text-overflow:ellipsis;white-space:nowrap}.position-edit{flex:0 0 auto;padding:7rpx 10rpx;border:1rpx solid #d0d7ff;border-radius:8rpx;color:#1456f0;background:#eff4ff;font-size:18rpx}.child-edit{margin-left:8rpx}.committee-list{margin-top:14rpx;padding:10rpx;border-radius:16rpx;background:#f7f8fa}.committee-item{display:flex;align-items:center;justify-content:space-between;margin-bottom:10rpx;padding:12rpx;border:1rpx solid #eef0f5;border-radius:14rpx;color:#646a73;background:#fff}.committee-item:last-child{margin-bottom:0}.committee-item.active{border-color:#397bd0;background:#eff6ff}.committee-item.compact>view:first-child{display:flex;flex:1;align-items:center;justify-content:space-between;min-width:0;gap:10rpx}.committee-name{flex:0 0 auto;color:#17233f;font-size:22rpx;font-weight:800;white-space:nowrap}.committee-role{overflow:hidden;color:#1456f0;font-size:25rpx;font-weight:900;text-align:right;text-overflow:ellipsis;white-space:nowrap}.committee-arrow{margin-left:8rpx;color:#8a93a3;font-size:28rpx}.category-footer{display:flex;justify-content:space-between;margin-top:auto;padding-top:14rpx;border-top:1rpx solid #eef0f5;color:#1456f0;font-size:19rpx;font-weight:800}.ledger-note{margin-top:12rpx;color:#646a73;font-size:18rpx;line-height:1.5}
.participant-summary{display:flex;align-items:center;justify-content:space-between;padding:22rpx 24rpx;border:2rpx solid #cbd3e1;border-radius:17rpx;background:#f5f7fb}.participant-total{color:#17233f;font-size:34rpx;font-weight:900}.participant-help{margin-top:5rpx;color:#6f7888;font-size:20rpx}.legacy-participant-note{margin-top:14rpx;padding:16rpx 18rpx;border-radius:15rpx;color:#805e28;background:#fff2d8;font-size:20rpx;line-height:1.55}.participant-team{overflow:hidden;margin-top:16rpx;border:2rpx solid #dfe4ee;border-radius:20rpx;background:#fff}.participant-team-head{display:flex;align-items:center;justify-content:space-between;padding:22rpx 24rpx}.participant-team-name{color:#17233f;font-size:27rpx;font-weight:900}.participant-team-count{margin-top:5rpx;color:#778193;font-size:19rpx}.participant-team-arrow{color:#8054cc;font-size:21rpx;font-weight:800}.participant-member-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12rpx;padding:0 18rpx 18rpx}.participant-member{display:flex;align-items:center;min-width:0;padding:16rpx 14rpx;border:2rpx solid #dfe4ee;border-radius:16rpx;color:#26324b;background:#f7f9fc;font-size:22rpx;font-weight:800}.participant-member text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.participant-checkbox{display:flex;flex:0 0 34rpx;align-items:center;justify-content:center;width:34rpx;height:34rpx;margin-right:10rpx;border:2rpx solid #b8c1d1;border-radius:9rpx;color:#fff;font-size:22rpx;font-weight:900}.participant-member.checked{border-color:#8054cc;background:#f1e9ff;color:#4d2c83}.participant-member.checked .participant-checkbox{border-color:#8054cc;background:#8054cc}.participant-team-green{border-color:rgba(36,209,143,.35)}.participant-team-red{border-color:rgba(255,94,122,.35)}.participant-team-blue{border-color:rgba(79,176,255,.35)}.participant-team-purple{border-color:rgba(185,110,255,.35)}
.participant-select-button{flex:0 0 auto;margin-left:18rpx;padding:14rpx 27rpx;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#8054cc,#397bd0);font-size:23rpx;font-weight:900;box-shadow:0 8rpx 18rpx rgba(87,73,171,.2)}
.template-section{border-color:#d9cbee;background:linear-gradient(145deg,#fff 0,#faf7ff 100%)}.keyword-examples{display:flex;flex-wrap:wrap;align-items:center;gap:9rpx;margin-top:12rpx;color:#858d9d;font-size:18rpx}.keyword-chip{padding:5rpx 11rpx;border-radius:999rpx;color:#6945ad;background:#eee7fa}.template-button{display:flex;align-items:center;justify-content:center;gap:12rpx;margin:20rpx 0 0;border:0;border-radius:18rpx;color:#fff;background:linear-gradient(135deg,#8054cc,#397bd0);font-size:27rpx;font-weight:800;box-shadow:0 10rpx 22rpx rgba(87,73,171,.22)}.template-button-icon{padding:3rpx 8rpx;border-radius:8rpx;color:#6842aa;background:#fff;font-size:17rpx}.template-note{margin-top:14rpx;padding:15rpx 18rpx;border-radius:14rpx;color:#286b58;background:#e8f5ef;font-size:20rpx}.template-note.success:before{margin-right:7rpx;content:"✓"}
.photo-section{border:3rpx solid #edaa45;background:linear-gradient(180deg,#fffdf7,#fff)}.photo-recommended{display:inline-block;margin-left:10rpx;padding:4rpx 10rpx;border-radius:999rpx;color:#8b4b00;background:#ffe1a8;font-size:18rpx;vertical-align:middle}.photo-upload{display:flex;align-items:center;padding:28rpx 23rpx;border:3rpx dashed #de8316;border-radius:20rpx;background:#fff4d6}.upload-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;margin-right:17rpx;border-radius:19rpx;color:#fff;background:linear-gradient(145deg,#ef9e26,#d56912);font-size:42rpx;font-weight:900}.upload-copy{flex:1}.upload-title{color:#693800;font-size:27rpx;font-weight:900}.upload-desc{margin-top:5rpx;color:#865f2e;font-size:20rpx}.upload-arrow{color:#b75c08;font-size:44rpx;font-weight:900}.photo-preview{display:grid;grid-template-columns:repeat(3,1fr);gap:13rpx;margin-top:18rpx}.preview-item{position:relative;height:160rpx;overflow:hidden;border-radius:17rpx;background:#e9edf4}.preview-item image{width:100%;height:100%}.photo-index{position:absolute;bottom:7rpx;left:7rpx;padding:2rpx 9rpx;border-radius:999rpx;color:#fff;background:rgba(20,24,40,.65);font-size:17rpx}.remove-photo{position:absolute;top:7rpx;right:7rpx;width:43rpx;height:43rpx;border-radius:50%;color:#fff;background:rgba(28,30,47,.82);font-size:32rpx;line-height:40rpx;text-align:center}
.uploader-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid #edf0f5}.uploader-label{color:#26324b;font-weight:800}.uploader-desc{margin-top:4rpx;color:#8a93a3;font-size:18rpx}.uploader-name{width:230rpx;padding:14rpx 17rpx;border-radius:14rpx;color:#5b6476!important;-webkit-text-fill-color:#5b6476!important;background:#e9edf4!important;box-sizing:border-box;text-align:right;opacity:1}
.honor-section{border-color:#ead2ff;background:linear-gradient(145deg,#fff 0,#fbf6ff 100%)}.honor-number{color:#fff;background:linear-gradient(145deg,#b260f1,#397bd0)}.honor-options{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.honor-option{display:flex;align-items:flex-start;gap:12rpx;padding:20rpx;border:2rpx solid #d9deea;border-radius:18rpx;background:#f7f9fc}.honor-option.active{border-color:#8d58d9;background:#f2e9ff;box-shadow:0 10rpx 22rpx rgba(125,82,198,.13)}.honor-radio{color:#8c58d7;font-size:28rpx;line-height:1.2}.honor-label{color:#17233f;font-size:26rpx;font-weight:900}.honor-desc{margin-top:5rpx;color:#6e788b;font-size:18rpx;line-height:1.45}.confirm-tip{margin-top:18rpx;padding:18rpx 20rpx;border-radius:16rpx;color:#5f3c91;background:#f1e8fb;font-size:20rpx;line-height:1.6}
.footer-actions{position:fixed;right:0;bottom:0;left:0;z-index:10;display:flex;gap:17rpx;padding:19rpx 24rpx calc(19rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dfe4ee;background:rgba(255,255,255,.97);box-shadow:0 -12rpx 34rpx rgba(43,50,85,.12)}.draft-button,.publish-button{flex:1;border-radius:999rpx;font-size:27rpx;font-weight:800}.draft-button{color:#39445a;background:#e9edf4}.publish-button{color:#fff;background:linear-gradient(135deg,#8054cc,#397bd0)}
.publish-button.saving{color:#fff;background:#778092}
