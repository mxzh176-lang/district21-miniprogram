<view class="page">
  <view class="scope-bar" bindtap="chooseOrgScope">
    <view>
      <view class="scope-kicker">当前范围</view>
      <view class="scope-name">{{currentScope.orgName}}</view>
    </view>
    <view class="scope-action">切换 ▼</view>
  </view>

  <view class="archive-error" wx:if="{{loadError}}">{{loadError}}</view>

  <view class="photo-library" wx:if="{{canOpenMediaDrive}}" bindtap="uploadPhotos">
    <view>
      <view class="photo-kicker">TEAM CLOUD DRIVE</view>
      <view class="photo-title">服务队云盘</view>
      <view class="photo-desc">会议、联谊、关爱、服务照片与视频集中保存</view>
    </view>
    <view class="upload-button">进入 ›</view>
  </view>

  <view class="confirm-entry" wx:if="{{pendingConfirmCount}}" bindtap="openConfirmations">
    <view>
      <view class="confirm-title">待直属确认</view>
      <view class="confirm-desc">有 {{pendingConfirmCount}} 条荣誉申报需要直属上级处理</view>
    </view>
    <view class="confirm-action">去确认 ›</view>
  </view>
  <view class="confirm-entry" wx:if="{{pendingVerifyCount}}" bindtap="openConfirmations">
    <view>
      <view class="confirm-title">待荣誉核准</view>
      <view class="confirm-desc">有 {{pendingVerifyCount}} 条荣誉申报需要荣誉主席核准入榜</view>
    </view>
    <view class="confirm-action">去核准 ›</view>
  </view>

  <view class="honor-overview" bindtap="openHonorWall">
    <view class="honor-heading">
      <view>
        <view class="honor-title">荣誉事件统计</view>
        <view class="honor-desc">按当前组织与当前任期统计已核准入榜事件</view>
      </view>
      <view class="honor-link">事件墙 ›</view>
    </view>
    <view class="honor-stats">
      <view class="honor-stat" wx:for="{{honorLevels}}" wx:key="key" data-level="{{item.level}}" catchtap="openHonorWall">
        <view class="honor-value">{{item.count || 0}}</view>
        <view class="honor-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="recent-section history-panel">
    <view class="recent-heading">
      <view>
        <view class="section-title">历史事件</view>
        <view class="section-desc">最新归档内容在这里集中展示，超过首屏后可展开查看</view>
      </view>
      <view class="history-link" bindtap="openHistoryList">历史事件 ›</view>
    </view>
    <view class="history-grid" wx:if="{{visibleRecentEntries.length}}">
        <view
          class="recent-card"
          wx:for="{{visibleRecentEntries}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="openRecentEntry"
        >
          <swiper
            wx:if="{{item.carouselPhotos.length}}"
            class="recent-swiper"
            circular
            autoplay
            interval="3600"
            duration="450"
            indicator-dots="{{item.carouselPhotos.length > 1}}"
            indicator-color="rgba(255,255,255,.35)"
            indicator-active-color="#ffffff"
          >
            <swiper-item wx:for="{{item.carouselPhotos}}" wx:for-item="photo" wx:key="*this">
              <image class="recent-photo" src="{{photo}}" mode="aspectFill" />
            </swiper-item>
          </swiper>
          <view wx:else class="recent-badge">{{item.coverText}}</view>
          <view class="recent-category">{{item.categoryName}}</view>
          <view class="recent-date">{{item.dateLabel}}</view>
          <view class="recent-title">{{item.title}}</view>
          <view class="recent-summary">{{item.summaryText}}</view>
          <view class="recent-meta">{{item.meta}}</view>
        </view>
    </view>
    <view wx:else class="archive-empty compact-empty" bindtap="openHistoryList">暂无最新归档，点击查看历史事件 ›</view>
    <view wx:if="{{historyHasMore}}" class="history-fold" bindtap="toggleHistoryFold">
      {{historyExpanded ? '收起历史事件' : '展开更多历史事件'}} ›
    </view>
  </view>
</view>
