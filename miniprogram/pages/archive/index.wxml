<view class="page">
  <view class="scope-card" bindtap="chooseOrgScope">
    <view>
      <view class="scope-kicker">当前范围</view>
      <view class="scope-name">{{currentScope.orgName || '二十一协作区'}}</view>
    </view>
    <view class="scope-switch">切换 ▼</view>
  </view>

  <view class="archive-hero">
    <view class="hero-kicker">ARCHIVE DIRECTORY</view>
    <view class="hero-title">让狮爱有迹可循</view>
    <view class="hero-desc">{{currentScope.orgType === 'team' ? currentScope.orgName : '协作区与服务队'}}档案，岗位人员直接填写内容</view>
  </view>

  <view class="archive-error" wx:if="{{loadError}}">{{loadError}}</view>

  <scroll-view scroll-x class="organization-scroll" wx:if="{{organizations.length > 1}}">
    <view class="organization-tabs">
      <view
        class="organization-tab {{selectedId === item.id ? 'active' : ''}}"
        wx:for="{{organizations}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectOrganization"
      >{{item.shortName}}</view>
    </view>
  </scroll-view>

  <view class="organization-card">
    <view class="organization-seal" style="border-color: {{selectedOrganization.color}}; color: {{selectedOrganization.color}}">
      {{selectedOrganization.seal}}
    </view>
    <view class="organization-copy">
      <view class="organization-name">{{selectedOrganization.name}}</view>
      <view class="organization-desc">{{selectedOrganization.description}}</view>
    </view>
    <view wx:if="{{canManage}}" class="cloud-inline" bindtap="uploadPhotos">
      <view class="photo-kicker">照片云盘</view>
      <view class="photo-count-inline">{{selectedOrganization.photoCount}} 张</view>
      <view class="upload-button">内部附件</view>
    </view>
  </view>

  <view class="confirm-entry" wx:if="{{pendingConfirmCount}}" bindtap="openConfirmations">
    <view>
      <view class="confirm-title">待直属确认</view>
      <view class="confirm-desc">有 {{pendingConfirmCount}} 条荣誉申报需要直属上级处理</view>
    </view>
    <view class="confirm-action">去确认 ›</view>
  </view>
  <view class="confirm-entry" wx:if="{{pendingVerifyCount}}" bindtap="openConfirmations">
    <view>
      <view class="confirm-title">待荣誉核准</view>
      <view class="confirm-desc">有 {{pendingVerifyCount}} 条荣誉申报需要荣誉主席核准入榜</view>
    </view>
    <view class="confirm-action">去核准 ›</view>
  </view>

  <view class="honor-overview" bindtap="openHonorWall">
    <view class="honor-heading">
      <view>
        <view class="honor-title">荣誉事件统计</view>
        <view class="honor-desc">按当前服务队与当前任期统计已核准入榜事件</view>
      </view>
      <view class="honor-link">事件墙 ›</view>
    </view>
    <view class="honor-stats">
      <view class="honor-stat" data-level="good" catchtap="openHonorWall">
        <view class="honor-value">{{honorStats.counts.good || 0}}</view>
        <view class="honor-label">优秀</view>
      </view>
      <view class="honor-stat" data-level="great" catchtap="openHonorWall">
        <view class="honor-value">{{honorStats.counts.great || 0}}</view>
        <view class="honor-label">杰出</view>
      </view>
      <view class="honor-stat" data-level="excellent" catchtap="openHonorWall">
        <view class="honor-value">{{honorStats.counts.excellent || 0}}</view>
        <view class="honor-label">卓越</view>
      </view>
    </view>
  </view>

  <view class="section-row">
    <view>
      <view class="section-title">档案栏目</view>
      <view class="section-desc">通讯录已独立为单独页面，不在档案中重复维护</view>
    </view>
  </view>

  <view class="category-grid">
    <view
      class="category-card {{item.restricted ? 'restricted' : ''}}"
      wx:for="{{selectedOrganization.categories}}"
      wx:key="id"
      data-category="{{item.id}}"
      data-restricted="{{item.restricted}}"
      bindtap="addContent"
    >
      <view class="category-heading">
        <view class="category-name">{{item.name}}</view>
        <view class="category-person">{{item.person}}</view>
        <view wx:if="{{item.canEditDirectory}}" class="position-edit" data-position="{{item.positionId}}" catchtap="editPosition">编辑</view>
      </view>
      <view wx:if="{{item.children && item.children.length}}" class="committee-list">
        <view
          class="committee-item compact"
          wx:for="{{item.children}}"
          wx:key="id"
          data-category="{{item.id}}"
          catchtap="openSubArchive"
        >
          <view>
            <view class="committee-name">{{item.name}}</view>
            <view class="committee-role">{{item.person}}</view>
          </view>
          <view class="committee-arrow">›</view>
          <view wx:if="{{item.canEditDirectory}}" class="position-edit child-edit" data-position="{{item.positionId}}" catchtap="editPosition">编辑</view>
        </view>
      </view>
      <view class="category-footer">
        <text>{{item.count}}条</text>
        <text>{{item.canMaintain ? '填写 ›' : '查看 ›'}}</text>
      </view>
      <view wx:if="{{item.id === 'treasurer'}}" class="ledger-note">账目公开透明，所有成员可查看；仅管理员和司库可维护。</view>
    </view>
  </view>
</view>
