<view class="page">
  <view class="ledger-hero">
    <view class="hero-kicker">OPEN LEDGER</view>
    <view class="hero-title">{{organization.name}}账目</view>
    <view class="hero-desc">账目公开透明，所有成员可查看；仅管理员和当前有效司库可维护。</view>
    <button wx:if="{{canEdit}}" class="create-button" bindtap="openCreate">＋ 新增账目</button>
  </view>

  <view class="form-card" wx:if="{{showForm}}">
    <input class="input" value="{{form.title}}" data-field="title" bindinput="onInput" placeholder="账目标题" />
    <input class="input" type="digit" value="{{form.amount}}" data-field="amount" bindinput="onInput" placeholder="金额" />
    <picker range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange"><view class="picker">{{typeOptions[typeIndex].label}}</view></picker>
    <picker mode="date" value="{{form.date}}" bindchange="onDateChange"><view class="picker">{{form.date}}</view></picker>
    <textarea class="textarea" value="{{form.description}}" data-field="description" bindinput="onInput" placeholder="账目说明"></textarea>
    <view class="form-actions"><button bindtap="closeForm">取消</button><button class="save" bindtap="saveRecord">保存</button></view>
  </view>

  <view class="ledger-card" wx:for="{{records}}" wx:key="id">
    <view class="ledger-main">
      <view class="ledger-title">{{item.title}}</view>
      <view class="ledger-meta">{{item.date}} · {{item.type}}</view>
      <view class="ledger-desc">{{item.description}}</view>
    </view>
    <view class="amount {{item.type}}">¥{{item.amount}}</view>
    <view wx:if="{{canEdit}}" class="record-actions"><text data-id="{{item.id}}" bindtap="editRecord">编辑</text><text class="delete" data-id="{{item.id}}" bindtap="deleteRecord">删除</text></view>
  </view>
  <view class="empty" wx:if="{{!records.length}}">当前暂无账目记录。</view>
</view>
