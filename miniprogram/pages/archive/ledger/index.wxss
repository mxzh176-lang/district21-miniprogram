.ledger-hero,.form-card,.ledger-card{padding:28rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:24rpx;background:#1b153b}.ledger-hero{background:linear-gradient(145deg,#6333a5,#224f91)}.hero-title{margin-top:10rpx;color:#fff;font-size:36rpx;font-weight:800}.hero-desc{margin-top:8rpx;color:#d7c8e8;font-size:20rpx;line-height:1.6}.create-button{margin-top:22rpx;color:#fff;background:rgba(255,255,255,.16)}.form-card,.ledger-card{margin-top:18rpx}.input,.picker,.textarea{box-sizing:border-box;width:100%;margin-bottom:14rpx;padding:20rpx;border-radius:14rpx;color:#fff;background:#2a2050}.textarea{height:160rpx}.form-actions{display:flex;gap:14rpx}.form-actions button{flex:1}.form-actions .save{color:#fff;background:#7447c8}.ledger-card{position:relative;display:flex;align-items:flex-start}.ledger-main{flex:1;min-width:0}.ledger-title{color:#fff;font-size:26rpx;font-weight:700}.ledger-meta,.ledger-desc{margin-top:8rpx;color:#aaa2bf;font-size:19rpx}.amount{margin-left:18rpx;color:#7be4ff;font-size:28rpx;font-weight:800}.amount.expense{color:#ff9b9b}.record-actions{position:absolute;right:26rpx;bottom:18rpx;display:flex;gap:18rpx;color:#7be4ff;font-size:18rpx}.record-actions .delete{color:#ff9b9b}.empty{padding:40rpx;color:#8f879e;text-align:center}
