.page{min-height:100vh;padding:24rpx 24rpx 80rpx;background:#0f0b25;box-sizing:border-box}.hero{padding:32rpx;border:1rpx solid rgba(201,130,255,.24);border-radius:28rpx;color:#fff;background:radial-gradient(circle at 92% 8%,rgba(123,228,255,.22),transparent 30%),linear-gradient(145deg,#602fa4,#1f5798);box-shadow:0 18rpx 46rpx rgba(0,0,0,.24)}.hero-kicker{color:#7be4ff;font-size:17rpx;letter-spacing:3rpx}.hero-title{margin-top:10rpx;color:#fff;font-size:42rpx;font-weight:900}.hero-desc{margin-top:8rpx;color:#d7cfee;font-size:21rpx}.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:24rpx}.stat{padding:18rpx 10rpx;border-radius:18rpx;background:rgba(255,255,255,.1);text-align:center}.value{color:#e6bdff;font-size:42rpx;font-weight:900}.label{margin-top:4rpx;color:#d9d2e8;font-size:19rpx}.filter-card{display:grid;grid-template-columns:1fr;gap:12rpx;margin-top:18rpx;padding:20rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:22rpx;background:#1b153b}.filter-value{display:flex;align-items:center;justify-content:space-between;padding:17rpx 20rpx;border-radius:16rpx;color:#fff;background:#2a2050;font-size:21rpx;font-weight:800}.section-title{margin:28rpx 0 14rpx;color:#fff;font-size:27rpx;font-weight:900}.empty{padding:26rpx;border-radius:20rpx;color:#bcb2ce;background:#1b153b;text-align:center}.person-card,.event-card{margin-bottom:14rpx;padding:22rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:22rpx;background:#1b153b}.person-card{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.person-name{color:#fff;font-size:25rpx;font-weight:900}.person-role{margin-top:5rpx;color:#9d93b7;font-size:18rpx}.mini-stats{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8rpx;color:#7be4ff;font-size:18rpx}.mini-stats text{padding:5rpx 10rpx;border-radius:999rpx;background:#2a2050}.event-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.event-date{color:#9d93b7;font-size:18rpx}.event-title{margin-top:6rpx;color:#fff;font-size:27rpx;font-weight:900;line-height:1.35}.badge{flex:0 0 auto;padding:8rpx 14rpx;border-radius:999rpx;color:#ffe5a6;background:#49351b;font-size:18rpx;font-weight:900}.event-meta{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx;color:#c982ff;font-size:18rpx}.event-meta text{padding:6rpx 10rpx;border-radius:999rpx;background:#2a2050}
