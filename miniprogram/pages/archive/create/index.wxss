.page{min-height:100vh;padding:24rpx 24rpx 140rpx;background:#f7f8fa;box-sizing:border-box;color:#1f2329}.scope-bar{display:flex;align-items:center;justify-content:space-between;margin:18rpx 0;padding:20rpx 24rpx;border:1rpx solid #e8eaf0;border-radius:22rpx;color:#1f2329;background:#fff;box-shadow:0 8rpx 28rpx rgba(31,35,41,.05)}.scope-kicker{color:#3370ff;font-size:18rpx;letter-spacing:3rpx}.scope-name{margin-top:6rpx;color:#1f2329;font-size:31rpx;font-weight:900}.scope-action{padding:11rpx 18rpx;border-radius:999rpx;color:#1456f0;background:#eff4ff;font-size:21rpx;font-weight:800}.create-hero{padding:34rpx;border-radius:28rpx;color:#fff;background:radial-gradient(circle at 86% 12%,rgba(255,255,255,.36),transparent 30%),linear-gradient(135deg,#3370ff,#7b7df7);box-shadow:0 18rpx 42rpx rgba(20,86,240,.14)}.hero-kicker{color:#fff;font-size:18rpx;letter-spacing:3rpx;opacity:.86}.hero-title{margin-top:12rpx;color:#fff;font-size:43rpx;font-weight:900}.hero-desc{margin-top:9rpx;color:rgba(255,255,255,.78);font-size:22rpx;line-height:1.5}.archive-error{margin-top:18rpx;padding:22rpx;border-left:6rpx solid #d83931;border-radius:14rpx;color:#8a3f39;background:#fff0ee;line-height:1.6}.quick-create-card{display:flex;align-items:center;margin-top:22rpx;padding:24rpx;border:1rpx solid #e7ecf5;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(31,35,41,.06)}.quick-create-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;margin-right:18rpx;border-radius:20rpx;color:#fff;background:#1456f0;font-size:27rpx;font-weight:900}.quick-create-copy{flex:1;min-width:0}.quick-create-title{font-size:28rpx;font-weight:900}.quick-create-desc{margin-top:6rpx;color:#8f959e;font-size:20rpx}.quick-create-arrow{color:#1456f0;font-size:38rpx}.section-row{margin-top:30rpx}.section-title{color:#1f2329;font-size:32rpx;font-weight:900}.section-desc{margin-top:7rpx;color:#646a73;font-size:20rpx;line-height:1.5}.category-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:19rpx}.category-card{position:relative;display:flex;flex-direction:column;min-height:180rpx;padding:22rpx;border:1rpx solid #eef0f5;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(31,35,41,.06);box-sizing:border-box}.category-card.restricted{background:#faf8ff}.category-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}.category-name{flex:1;min-width:0;color:#1f2329;font-size:27rpx;font-weight:900;line-height:1.25}.category-person{overflow:hidden;max-width:150rpx;color:#1456f0;font-size:30rpx;font-weight:900;text-align:right;text-overflow:ellipsis;white-space:nowrap}.position-edit{flex:0 0 auto;padding:7rpx 10rpx;border:1rpx solid #d0d7ff;border-radius:8rpx;color:#1456f0;background:#eff4ff;font-size:18rpx}.child-edit{margin-left:8rpx}.committee-list{margin-top:14rpx;padding:10rpx;border-radius:16rpx;background:#f7f8fa}.committee-item{display:flex;align-items:center;justify-content:space-between;margin-bottom:10rpx;padding:12rpx;border:1rpx solid #eef0f5;border-radius:14rpx;color:#646a73;background:#fff}.committee-item:last-child{margin-bottom:0}.committee-item.compact>view:first-child{display:flex;flex:1;align-items:center;justify-content:space-between;min-width:0;gap:10rpx}.committee-name{flex:0 0 auto;color:#1f2329;font-size:22rpx;font-weight:800;white-space:nowrap}.committee-role{overflow:hidden;color:#1456f0;font-size:25rpx;font-weight:900;text-align:right;text-overflow:ellipsis;white-space:nowrap}.committee-arrow{margin-left:8rpx;color:#8a93a3;font-size:28rpx}.category-footer{display:flex;justify-content:space-between;margin-top:auto;padding-top:14rpx;border-top:1rpx solid #eef0f5;color:#1456f0;font-size:19rpx;font-weight:800}.ledger-note{margin-top:12rpx;color:#646a73;font-size:18rpx;line-height:1.5}
