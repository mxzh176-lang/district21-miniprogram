.edit-hero,.form-card{padding:28rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:24rpx;background:#1b153b}.edit-hero{background:linear-gradient(145deg,#6333a5,#224f91)}.hero-title{margin-top:10rpx;color:#fff;font-size:35rpx;font-weight:800}.hero-desc{margin-top:8rpx;color:#d7c8e8;font-size:20rpx;line-height:1.65}.form-card{margin-top:20rpx}.field-label{margin:22rpx 0 9rpx;color:#cbbbea;font-size:21rpx}.input,.picker-value{box-sizing:border-box;width:100%;padding:22rpx;border-radius:14rpx;color:#fff;-webkit-text-fill-color:#fff;background:#2a2050}.input-placeholder{color:#8f86a4;-webkit-text-fill-color:#8f86a4}.date-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.date-field{min-width:0}.save-button{margin-top:28rpx;color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd)}
