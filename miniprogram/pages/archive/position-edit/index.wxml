<view class="page">
  <view class="edit-hero">
    <view class="hero-kicker">POSITION DIRECTORY</view>
    <view class="hero-title">编辑职务与负责人</view>
    <view class="hero-desc">仅超级管理员、协作区管理员或当前服务队管理员可保存。</view>
  </view>

  <view class="form-card" wx:if="{{!loading}}">
    <view class="field-label">职务名称</view>
    <input class="input" value="{{name}}" maxlength="100" bindinput="onNameInput" placeholder="请填写职务名称" placeholder-class="input-placeholder" cursor-color="#d391ff" />

    <view class="field-label">文档负责人</view>
    <picker range="{{users}}" range-key="displayName" value="{{userIndex}}" bindchange="onUserChange">
      <view class="picker-value">{{users.length ? users[userIndex].displayName : '暂无资料完整的成员'}}</view>
    </picker>
    <view class="field-tip">保存后，该成员会成为本栏目负责人，并直接获得该栏目档案的维护权限。</view>

    <view class="date-row">
      <view class="date-field">
        <view class="field-label">任期开始</view>
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange"><view class="picker-value">{{startDate}}</view></picker>
      </view>
      <view class="date-field">
        <view class="field-label">任期结束</view>
        <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange"><view class="picker-value">{{endDate}}</view></picker>
      </view>
    </view>
    <button class="save-button" loading="{{saving}}" disabled="{{saving || !users.length}}" bindtap="save">保存负责人并授权</button>
  </view>
</view>
