.archive-hero {
  padding: 34rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(145deg, #24154f, #3a2675);
}

.archive-error {
  margin-top: 18rpx;
  padding: 22rpx;
  border-left: 6rpx solid #bd5d56;
  border-radius: 14rpx;
  color: #8a3f39;
  background: #fff0ee;
  line-height: 1.6;
}

.hero-kicker,
.photo-kicker {
  color: #d391ff;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #fff;
  font-family: serif;
  font-size: 43rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.28);
}

.hero-desc {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 21rpx;
}

.organization-scroll {
  margin: 22rpx 0;
  white-space: nowrap;
}

.organization-tabs {
  display: inline-flex;
  gap: 12rpx;
}

.organization-tab {
  padding: 13rpx 24rpx;
  border-radius: 999rpx;
  color: #66736f;
  background: #211943;
  font-size: 21rpx;
}

.organization-tab.active {
  color: #fff;
  background: #201447;
}

.organization-card {
  display: flex;
  align-items: center;
  padding: 25rpx;
  border-radius: 23rpx;
  background: #1b153b;
}
.organization-copy{flex:1;min-width:0}.cloud-inline{display:flex;flex:0 0 auto;align-items:center;gap:12rpx;margin-left:16rpx;padding-left:16rpx;border-left:1rpx solid rgba(201,130,255,.2)}.photo-count-inline{color:#dcb8ff;font-size:19rpx}.cloud-inline .upload-button{padding:10rpx 15rpx}

.organization-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin-right: 20rpx;
  border: 3rpx solid;
  border-radius: 50%;
  font-family: serif;
  font-weight: 700;
}

.organization-name {
  color: #f7f3ff;
  font-size: 30rpx;
  font-weight: 700;
}

.organization-desc,
.section-desc {
  margin-top: 6rpx;
  color: #9f97b6;
  font-size: 19rpx;
}

.photo-library {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 23rpx;
  color: #fff;
  background: linear-gradient(135deg, #234f78, #346b8c);
}

.photo-title {
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.photo-desc {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 18rpx;
}

.upload-button {
  padding: 13rpx 19rpx;
  border-radius: 999rpx;
  color: #284d69;
  background: #1b153b;
  font-size: 19rpx;
}

.section-row {
  margin-top: 30rpx;
}

.section-title {
  margin: 0;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 19rpx;
}

.recent-section {
  margin-top: 24rpx;
}

.recent-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-count {
  color: #c982ff;
  font-size: 18rpx;
}

.recent-card {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #1b153b;
}

.recent-cover,
.recent-placeholder {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  margin-right: 16rpx;
  border-radius: 15rpx;
}

.recent-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c982ff;
  background: #2d2050;
  font-family: serif;
  font-size: 30rpx;
  font-weight: 700;
}

.recent-copy {
  flex: 1;
  min-width: 0;
}

.recent-date {
  color: #b4acc6;
  font-size: 17rpx;
}

.recent-title {
  overflow: hidden;
  margin-top: 5rpx;
  color: #f7f3ff;
  font-size: 23rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  overflow: hidden;
  margin-top: 7rpx;
  color: #c982ff;
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-arrow {
  margin-left: 10rpx;
  color: #aab3af;
  font-size: 34rpx;
}

.archive-empty {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  color: #aaa0bd;
  background: #211a3c;
  line-height: 1.7;
  text-align: center;
}

.category-card {
  position:relative;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #1b153b;
}
.sort-actions{display:flex;gap:16rpx;margin-top:14rpx;padding-top:12rpx;border-top:1rpx solid rgba(201,130,255,.14);color:#7be4ff;font-size:18rpx}

.category-card.restricted {
  background: #211a3c;
}

.category-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  color: #d7a8ff;
  background: #2d2050;
  font-family: serif;
  font-weight: 700;
}

.category-name {
  margin-top: 15rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.category-role {
  overflow: hidden;
  margin-top: 5rpx;
  color: #9189a9;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-desc {
  margin-top: 10rpx;
  color: #aaa2bf;
  font-size: 18rpx;
  line-height: 1.55;
}

.expand-line {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  color: #7be4ff;
  background: rgba(123, 228, 255, 0.1);
  font-size: 18rpx;
}

.committee-list {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: rgba(45, 32, 80, 0.72);
}

.committee-item {
  margin-bottom: 8rpx;
  color: #f0e8ff;
  font-size: 18rpx;
  line-height: 1.45;
}

.committee-item:last-child {
  margin-bottom: 0;
}

.category-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 17rpx;
  padding-top: 13rpx;
  border-top: 1rpx solid rgba(201,130,255,.16);
  color: #c982ff;
  font-size: 18rpx;
}

.archive-hero {
  border: 1rpx solid rgba(211, 145, 255, 0.32);
  background:
    radial-gradient(circle at 88% 12%, rgba(99, 215, 255, 0.2), transparent 28%),
    linear-gradient(145deg, #6333a5, #224f91);
  box-shadow: 0 20rpx 52rpx rgba(55, 20, 116, 0.32);
}

.hero-kicker,
.photo-kicker,
.record-count {
  color: #7be4ff;
}

.organization-tab {
  border: 1rpx solid rgba(201, 130, 255, 0.12);
  color: #aaa2bf;
  background: rgba(31, 24, 65, 0.86);
}

.organization-tab.active {
  color: #fff;
  background: linear-gradient(135deg, #a15be8, #377ddd);
}

.organization-card,
.recent-card,
.category-card {
  border: 1rpx solid rgba(201, 130, 255, 0.16);
  background: rgba(27, 21, 59, 0.88);
  box-shadow: 0 14rpx 38rpx rgba(4, 4, 22, 0.2);
}

.organization-seal {
  border-color: #d391ff !important;
  color: #e8c4ff !important;
  box-shadow: 0 0 28rpx rgba(211, 145, 255, 0.22);
}

.photo-library {
  border: 1rpx solid rgba(124, 222, 255, 0.22);
  background: linear-gradient(135deg, rgba(108, 53, 177, 0.92), rgba(31, 91, 155, 0.94));
  box-shadow: 0 18rpx 46rpx rgba(30, 45, 112, 0.3);
}

.upload-button {
  color: #fff;
  background: rgba(255, 255, 255, 0.16);
}

.category-icon,
.recent-placeholder {
  color: #e3bcff;
  background: linear-gradient(145deg, rgba(159, 88, 225, 0.3), rgba(61, 111, 180, 0.26));
}
