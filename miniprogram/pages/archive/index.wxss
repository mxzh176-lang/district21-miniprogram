.scope-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(123, 228, 255, .22);
  border-radius: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, rgba(33, 24, 73, .96), rgba(21, 50, 90, .9));
}

.scope-kicker {
  color: #7be4ff;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.scope-name {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.scope-switch {
  padding: 10rpx 17rpx;
  border-radius: 999rpx;
  color: #dff8ff;
  background: rgba(123, 228, 255, .14);
  font-size: 20rpx;
  font-weight: 800;
}

.archive-hero {
  padding: 34rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(145deg, #24154f, #3a2675);
}

.archive-error {
  margin-top: 18rpx;
  padding: 22rpx;
  border-left: 6rpx solid #bd5d56;
  border-radius: 14rpx;
  color: #8a3f39;
  background: #fff0ee;
  line-height: 1.6;
}

.hero-kicker,
.photo-kicker {
  color: #d391ff;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #fff;
  font-family: serif;
  font-size: 43rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.28);
}

.hero-desc {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 21rpx;
}

.organization-scroll {
  margin: 22rpx 0;
  white-space: nowrap;
}

.organization-tabs {
  display: inline-flex;
  gap: 12rpx;
}

.organization-tab {
  padding: 13rpx 24rpx;
  border-radius: 999rpx;
  color: #66736f;
  background: #211943;
  font-size: 21rpx;
}

.organization-tab.active {
  color: #fff;
  background: #201447;
}

.organization-card {
  display: flex;
  align-items: center;
  padding: 25rpx;
  border-radius: 23rpx;
  background: #1b153b;
}
.organization-copy{flex:1;min-width:0}.cloud-inline{display:flex;flex:0 0 auto;align-items:center;gap:12rpx;margin-left:16rpx;padding-left:16rpx;border-left:1rpx solid rgba(201,130,255,.2)}.photo-count-inline{color:#dcb8ff;font-size:19rpx}.cloud-inline .upload-button{padding:10rpx 15rpx}
.confirm-entry{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding:24rpx;border:1rpx solid rgba(255,196,108,.24);border-radius:22rpx;background:linear-gradient(135deg,rgba(78,48,20,.92),rgba(42,31,70,.92));box-shadow:0 14rpx 34rpx rgba(4,4,22,.18)}.confirm-title{color:#ffe3a6;font-size:28rpx;font-weight:900}.confirm-desc{margin-top:6rpx;color:#d8c9a9;font-size:19rpx}.confirm-action{color:#ffd88a;font-size:22rpx;font-weight:800}.honor-overview{margin-top:18rpx;padding:26rpx;border:1rpx solid rgba(201,130,255,.2);border-radius:24rpx;background:linear-gradient(135deg,rgba(44,28,86,.96),rgba(26,52,96,.92));box-shadow:0 16rpx 42rpx rgba(4,4,22,.22)}.honor-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.honor-title{color:#fff;font-size:29rpx;font-weight:900}.honor-desc{margin-top:6rpx;color:#aaa2bf;font-size:18rpx}.honor-link{color:#7be4ff;font-size:20rpx;font-weight:800}.honor-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10rpx;margin-top:20rpx}.honor-stat{padding:16rpx 8rpx;border-radius:18rpx;background:rgba(255,255,255,.08);text-align:center}.honor-value{color:#e6bdff;font-size:34rpx;font-weight:900}.honor-label{margin-top:4rpx;color:#d9d2e8;font-size:18rpx}

.organization-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin-right: 20rpx;
  border: 3rpx solid;
  border-radius: 50%;
  font-family: serif;
  font-weight: 700;
}

.organization-name {
  color: #f7f3ff;
  font-size: 30rpx;
  font-weight: 700;
}

.organization-desc,
.section-desc {
  margin-top: 6rpx;
  color: #9f97b6;
  font-size: 19rpx;
}

.photo-library {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 23rpx;
  color: #fff;
  background: linear-gradient(135deg, #234f78, #346b8c);
}

.photo-title {
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.photo-desc {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 18rpx;
}

.upload-button {
  padding: 13rpx 19rpx;
  border-radius: 999rpx;
  color: #284d69;
  background: #1b153b;
  font-size: 19rpx;
}

.section-row {
  margin-top: 30rpx;
}

.section-title {
  margin: 0;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-auto-rows: 1fr;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 19rpx;
}

.recent-section {
  margin-top: 24rpx;
}

.recent-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.history-link {
  color: #7be4ff;
  font-size: 21rpx;
  font-weight: 800;
}

.recent-scroll {
  width: 100%;
  white-space: nowrap;
}

.recent-track {
  display: inline-flex;
  gap: 18rpx;
  padding-right: 24rpx;
}

.record-count {
  color: #c982ff;
  font-size: 18rpx;
}

.recent-card {
  display: block;
  box-sizing: border-box;
  width: 360rpx;
  min-height: 390rpx;
  margin-bottom: 0;
  overflow: hidden;
  padding: 0 0 24rpx;
  border: 1rpx solid rgba(123, 228, 255, .18);
  border-radius: 22rpx;
  background: linear-gradient(145deg, rgba(86, 54, 150, .96), rgba(28, 71, 132, .92));
  box-shadow: 0 16rpx 38rpx rgba(4, 4, 22, .22);
}

.recent-swiper {
  width: 100%;
  height: 180rpx;
  background: rgba(255, 255, 255, .06);
}

.recent-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.recent-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin: 24rpx 24rpx 18rpx;
  border: 2rpx solid rgba(232, 196, 255, .78);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
}

.recent-category {
  display: inline-flex;
  max-width: 100%;
  margin: 20rpx 24rpx 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #7be4ff;
  background: rgba(123, 228, 255, .12);
  font-size: 18rpx;
  font-weight: 800;
}

.recent-cover,
.recent-placeholder {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  margin-right: 16rpx;
  border-radius: 15rpx;
}

.recent-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c982ff;
  background: #2d2050;
  font-family: serif;
  font-size: 30rpx;
  font-weight: 700;
}

.recent-copy {
  flex: 1;
  min-width: 0;
}

.recent-date {
  margin: 0 24rpx;
  color: #b4acc6;
  font-size: 20rpx;
}

.recent-title {
  overflow: hidden;
  display: -webkit-box;
  margin: 12rpx 24rpx 0;
  color: #f7f3ff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.32;
  white-space: normal;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recent-summary {
  overflow: hidden;
  display: -webkit-box;
  margin: 10rpx 24rpx 0;
  color: #bfb7d3;
  font-size: 18rpx;
  line-height: 1.45;
  white-space: normal;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recent-meta {
  overflow: hidden;
  margin: 12rpx 24rpx 0;
  color: #d9d2e8;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-arrow {
  margin-left: 10rpx;
  color: #aab3af;
  font-size: 34rpx;
}

.archive-empty {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  color: #aaa0bd;
  background: #211a3c;
  line-height: 1.7;
  text-align: center;
}

.compact-empty {
  padding: 24rpx;
  color: #7be4ff;
}

.category-card {
  position:relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #1b153b;
}
.category-card.restricted {
  background: #211a3c;
}

.category-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
}

.position-edit {
  flex: 0 0 auto;
  padding: 7rpx 10rpx;
  border: 1rpx solid rgba(201, 130, 255, 0.38);
  border-radius: 8rpx;
  color: #deb2ff;
  background: #2d2050;
  font-size: 18rpx;
}

.child-edit { margin-left: 8rpx; }

.category-name {
  color: #f8f4ff;
  font-size: 27rpx;
  font-weight: 800;
  white-space: nowrap;
}

.category-person {
  overflow: hidden;
  color: #7be4ff;
  font-size: 31rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-role {
  overflow: hidden;
  margin-top: 5rpx;
  color: #d7c5ff;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-desc {
  margin-top: 10rpx;
  color: #aaa2bf;
  font-size: 18rpx;
  line-height: 1.55;
}

.ledger-note {
  margin-top: 12rpx;
  color: #9f97b6;
  font-size: 17rpx;
  line-height: 1.5;
}

.committee-list {
  margin-top: 12rpx;
  padding: 10rpx;
  border-radius: 16rpx;
  background: rgba(45, 32, 80, 0.72);
}

.committee-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  padding: 13rpx 14rpx;
  border: 1rpx solid rgba(123, 228, 255, 0.13);
  border-radius: 14rpx;
  color: #f0e8ff;
  background: rgba(18, 13, 43, 0.54);
}

.committee-item:last-child {
  margin-bottom: 0;
}

.committee-item.compact {
  min-height: 68rpx;
  padding: 10rpx 12rpx;
}

.committee-item.compact > view:first-child {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  gap: 10rpx;
}

.committee-item.compact .committee-name {
  flex: 0 0 auto;
  font-size: 23rpx;
  white-space: nowrap;
}

.committee-item.compact .committee-role {
  overflow: hidden;
  margin-top: 0;
  font-size: 27rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.committee-item.compact .committee-arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
}

.committee-name {
  color: #f7f3ff;
  font-size: 24rpx;
  font-weight: 700;
}

.committee-role {
  margin-top: 7rpx;
  color: #7be4ff;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.committee-arrow {
  margin-left: 12rpx;
  color: #c982ff;
  font-size: 34rpx;
}

.category-footer {
  display: flex;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 13rpx;
  border-top: 1rpx solid rgba(201,130,255,.16);
  color: #c982ff;
  font-size: 18rpx;
}

.archive-hero {
  border: 1rpx solid rgba(211, 145, 255, 0.32);
  background:
    radial-gradient(circle at 88% 12%, rgba(99, 215, 255, 0.2), transparent 28%),
    linear-gradient(145deg, #6333a5, #224f91);
  box-shadow: 0 20rpx 52rpx rgba(55, 20, 116, 0.32);
}

.hero-kicker,
.photo-kicker,
.record-count {
  color: #7be4ff;
}

.organization-tab {
  border: 1rpx solid rgba(201, 130, 255, 0.12);
  color: #aaa2bf;
  background: rgba(31, 24, 65, 0.86);
}

.organization-tab.active {
  color: #fff;
  background: linear-gradient(135deg, #a15be8, #377ddd);
}

.organization-card,
.category-card {
  border: 1rpx solid rgba(201, 130, 255, 0.16);
  background: rgba(27, 21, 59, 0.88);
  box-shadow: 0 14rpx 38rpx rgba(4, 4, 22, 0.2);
}

.organization-seal {
  border-color: #d391ff !important;
  color: #e8c4ff !important;
  box-shadow: 0 0 28rpx rgba(211, 145, 255, 0.22);
}

.photo-library {
  border: 1rpx solid rgba(124, 222, 255, 0.22);
  background: linear-gradient(135deg, rgba(108, 53, 177, 0.92), rgba(31, 91, 155, 0.94));
  box-shadow: 0 18rpx 46rpx rgba(30, 45, 112, 0.3);
}

.upload-button {
  color: #fff;
  background: rgba(255, 255, 255, 0.16);
}

.recent-placeholder {
  color: #e3bcff;
  background: linear-gradient(145deg, rgba(159, 88, 225, 0.3), rgba(61, 111, 180, 0.26));
}
