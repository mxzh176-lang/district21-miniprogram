<view class="page">
  <view class="hero">
    <view class="hero-kicker">HONOR CONFIRMATION</view>
    <view class="hero-title">直属确认与荣誉核准</view>
    <view class="hero-desc">直属上级确认授予后，由荣誉主席核准入榜。</view>
  </view>

  <view wx:if="{{loading}}" class="empty">正在读取待处理事项…</view>
  <view wx:elif="{{!entries.length && !verifyEntries.length}}" class="empty">当前没有待直属确认或待荣誉核准事项。</view>

  <view wx:if="{{entries.length}}" class="section-title">待直属确认</view>

  <view class="confirm-card" wx:for="{{entries}}" wx:key="_id">
    <view class="card-head" data-id="{{item._id}}" bindtap="openDetail">
      <view>
        <view class="date">{{item.date}}</view>
        <view class="title">{{item.title}}</view>
      </view>
      <view class="status">待直属确认</view>
    </view>
    <view class="meta">
      <text>{{item.uploaderRole}}</text>
      <text>申报：{{item.honorRequestedLabel || item.honorLevelLabel}}</text>
      <text>主席：{{item.honorRecipientName || item.uploadedBy}}</text>
    </view>
    <view class="summary">{{item.summary}}</view>

    <picker range="{{levelOptions}}" range-key="label" data-index="{{index}}" bindchange="changeLevel">
      <view class="level-picker">
        <text>授予等级</text>
        <text>{{item.selectedLevelLabel}}⌄</text>
      </view>
    </picker>

    <view class="actions">
      <button class="secondary" data-id="{{item._id}}" bindtap="confirmArchive">确认归档</button>
      <button class="primary" data-index="{{index}}" bindtap="confirmGrant">确认授予</button>
      <button class="muted" data-id="{{item._id}}" bindtap="markNotGranted">暂不授予</button>
    </view>
  </view>

  <view wx:if="{{verifyEntries.length}}" class="section-title">待荣誉核准</view>

  <view class="confirm-card" wx:for="{{verifyEntries}}" wx:key="_id">
    <view class="card-head" data-id="{{item._id}}" bindtap="openDetail">
      <view>
        <view class="date">{{item.date}}</view>
        <view class="title">{{item.title}}</view>
      </view>
      <view class="status">{{item.honorStatus === 'need_recheck' ? '需复核' : '待荣誉核准'}}</view>
    </view>
    <view class="meta">
      <text>{{item.uploaderRole}}</text>
      <text>授予：{{item.honorConfirmedLabel || item.honorLevelLabel}}</text>
      <text>主席：{{item.honorRecipientName || item.uploadedBy}}</text>
      <text>直属确认：{{item.confirmedByName || '已确认'}}</text>
    </view>
    <view class="summary">{{item.summary}}</view>
    <view class="actions">
      <button class="primary" data-id="{{item._id}}" bindtap="verifyHonor">核准入榜</button>
      <button class="muted" data-id="{{item._id}}" bindtap="markNeedRecheck">需复核</button>
    </view>
  </view>
</view>
