.page{min-height:100vh;padding:24rpx 24rpx 70rpx;background:#0f0b25;box-sizing:border-box}.hero{padding:32rpx;border:1rpx solid rgba(201,130,255,.22);border-radius:28rpx;color:#fff;background:linear-gradient(145deg,#5c2fa0,#1f5798);box-shadow:0 18rpx 46rpx rgba(0,0,0,.24)}.hero-kicker{color:#7be4ff;font-size:17rpx;letter-spacing:3rpx}.hero-title{margin-top:10rpx;color:#fff;font-size:42rpx;font-weight:900}.hero-desc{margin-top:8rpx;color:#d7cfee;font-size:21rpx}.empty{margin-top:22rpx;padding:30rpx;border-radius:22rpx;color:#bcb2ce;background:#1b153b;text-align:center}.section-title{margin:30rpx 6rpx 8rpx;color:#ffe2a0;font-size:26rpx;font-weight:900}.confirm-card{margin-top:18rpx;padding:24rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:24rpx;background:#1b153b;box-shadow:0 14rpx 34rpx rgba(0,0,0,.18)}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.date{color:#9d93b7;font-size:18rpx}.title{margin-top:6rpx;color:#fff;font-size:28rpx;font-weight:900;line-height:1.35}.status{flex:0 0 auto;padding:7rpx 14rpx;border-radius:999rpx;color:#ffe2a0;background:#49351b;font-size:18rpx}.meta{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx;color:#c982ff;font-size:18rpx}.meta text{padding:6rpx 10rpx;border-radius:999rpx;background:#2a2050}.summary{margin-top:14rpx;color:#c9c0d9;font-size:20rpx;line-height:1.6}.level-picker{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding:18rpx 20rpx;border-radius:16rpx;color:#fff;background:#2a2050;font-size:22rpx;font-weight:800}.actions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12rpx;margin-top:18rpx}.actions button{margin:0;border-radius:16rpx;font-size:21rpx;font-weight:900;line-height:70rpx}.secondary{color:#fff;background:#33436d}.primary{color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd)}.muted{color:#f6d0d5;background:#59303c}
