.page{min-height:100vh;padding:28rpx;background:#0b1024;box-sizing:border-box}
.header-card{padding:38rpx;border-radius:26rpx;background:linear-gradient(135deg,#15346a,#3d65ad);color:#fff}
.eyebrow,.title,.subtitle{display:block}.eyebrow{color:#e4c754;font-size:24rpx}
.title{margin-top:8rpx;font-size:42rpx;font-weight:700}.subtitle{margin-top:12rpx;color:#dce6f8}
.notice,.denied{margin-top:24rpx;padding:24rpx;border-radius:16rpx;line-height:1.65}
.notice{border-left:6rpx solid #a15be8;background:#2a2048;color:#ddcdec}.denied{background:#351b34;color:#ffb7c2}
.upload-card,.result-card{margin-top:24rpx;padding:30rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:24rpx;background:#1b153b}
.step-title{display:block;margin-bottom:24rpx;color:#f2efff;font-size:32rpx;font-weight:700}
.choose-button,.analyze-button,.import-button{border-radius:999rpx;font-size:28rpx}
.choose-button{background:#eef2f8;color:#263c63}.analyze-button,.import-button{margin-top:20rpx;background:#173e7a;color:#fff}
.summary-row{display:flex;gap:18rpx;margin-bottom:22rpx}.summary-item{flex:1;padding:24rpx 12rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:16rpx;background:#251d49;text-align:center;color:#c8c0d8}
.summary-number{display:block;color:#7be4ff;font-size:40rpx;font-weight:700}
.draft-item{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid rgba(201,130,255,.16)}
.draft-date,.draft-title{display:block}.draft-date{color:#b4acc6;font-size:24rpx}.draft-title{margin-top:6rpx;color:#f7f3ff;font-weight:700}
.draft-status{flex-shrink:0;padding:8rpx 14rpx;border-radius:999rpx;background:#4b3820;color:#f6d78d;font-size:22rpx}
.final-note{display:block;margin-top:18rpx;color:#b4acc6;font-size:24rpx;text-align:center}
