.detail-hero {
  padding: 38rpx 30rpx;
  border-radius: 28rpx;
  color: #fff;
  text-align: center;
}

.tone-green { background: linear-gradient(145deg, #2c6a59, #201447); }
.tone-blue { background: linear-gradient(145deg, #477d9b, #244b64); }
.tone-red { background: linear-gradient(145deg, #c2746d, #7d3834); }
.tone-gold { background: linear-gradient(145deg, #bc8c45, #745020); }
.tone-purple { background: linear-gradient(145deg, #84689b, #4e3a60); }
.tone-teal { background: linear-gradient(145deg, #38817e, #225754); }

.detail-status {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.13);
  font-size: 17rpx;
}

.detail-date {
  margin-top: 33rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
}

.detail-title {
  margin-top: 9rpx;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

.detail-team {
  margin-top: 11rpx;
  color: #f0d598;
  font-weight: 700;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 17rpx;
  color: #f1ecf8;
}

.label {
  color: #b8afca;
}

.divider {
  height: 1rpx;
  margin: 22rpx 0;
  background: #3a2f5a;
}

.content-title {
  margin-top: 18rpx;
  color: #e0b9ff;
  font-weight: 700;
}

.content {
  margin-top: 9rpx;
  color: #ddd6e9;
  line-height: 1.85;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
}

.photo {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 230rpx;
  border-radius: 18rpx;
  overflow: hidden;
  color: #fff;
  background: #e8ece9;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-label {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, .62));
  font-size: 20rpx;
  text-align: center;
}

.draft-note {
  margin: 24rpx 0;
  padding: 21rpx;
  border-radius: 18rpx;
  color: #805e28;
  background: #f4e8d0;
  font-size: 19rpx;
  line-height: 1.6;
}
.detail-actions{display:flex;gap:18rpx;margin:26rpx 0}.detail-actions button{flex:1;color:#fff;background:#7546ba}.detail-actions .delete-button{background:#7f2d47}
