<view class="page" wx:if="{{entry._id}}">
  <view class="detail-hero tone-{{entry.tone}}">
    <view class="detail-status">岗位事件档案</view>
    <view class="detail-date">{{entry.dateLabel}}</view>
    <view class="detail-title">{{entry.title}}</view>
    <view class="detail-team">{{entry.team}}</view>
  </view>

  <view class="card">
    <view class="info-row"><text class="label">录入人</text><text>{{entry.uploadedBy}}</text></view>
    <view class="info-row"><text class="label">负责角色</text><text>{{entry.uploaderRole}}</text></view>
    <view class="info-row"><text class="label">地点</text><text>{{entry.location || '未填写'}}</text></view>
    <view class="info-row"><text class="label">参与人数</text><text>{{entry.participantCount || 0}} 人</text></view>
    <view class="participant-section" wx:if="{{entry.participantGroups.length}}">
      <view class="content-title">参与狮友</view>
      <view class="participant-group" wx:for="{{entry.participantGroups}}" wx:key="teamId">
        <view class="participant-group-head">
          <text>{{item.teamName}}</text>
          <text>{{item.count}}人</text>
        </view>
        <view class="participant-names">{{item.names}}</view>
      </view>
    </view>
    <view class="info-row" wx:if="{{entry.honorStatus && entry.honorStatus !== 'none'}}">
      <text class="label">荣誉状态</text>
      <text>{{entry.honorStatusText || entry.honorStatusLabel}}</text>
    </view>
    <view class="info-row" wx:if="{{entry.honorStatus && entry.honorStatus !== 'none'}}">
      <text class="label">荣誉等级</text>
      <text>{{entry.honorLevelLabel || entry.honorRequestedLabel}}</text>
    </view>
    <view class="info-row" wx:if="{{entry.honorRecipientName}}">
      <text class="label">获誉主席</text>
      <text>{{entry.honorRecipientName}}</text>
    </view>
    <view class="info-row" wx:if="{{entry.confirmedByName}}">
      <text class="label">直属确认人</text>
      <text>{{entry.confirmedByName}}</text>
    </view>
    <view class="info-row" wx:if="{{entry.honorVerifiedByName}}">
      <text class="label">荣誉核准人</text>
      <text>{{entry.honorVerifiedByName}}</text>
    </view>
    <view class="info-row"><text class="label">关键词</text><text>{{entry.keywordText}}</text></view>
    <view class="divider"></view>
    <view class="content-title">记录摘要</view>
    <view class="content">{{entry.summary}}</view>
    <view class="content-title">详细记录</view>
    <view class="content">{{entry.content}}</view>
  </view>

  <view wx:if="{{photos.length}}" class="section-title">关联图片</view>
  <view class="photo-grid">
    <view class="photo" wx:for="{{photos}}" wx:key="id"
      data-url="{{item.url}}" bindtap="previewPhoto">
      <image class="photo-image" src="{{item.url}}" mode="aspectFill" />
      <view class="photo-label">{{item.label}}</view>
    </view>
  </view>

  <view class="detail-actions" wx:if="{{canEdit || canDelete}}">
    <button wx:if="{{canEdit}}" bindtap="editEntry">编辑档案</button>
    <button wx:if="{{canDelete}}" class="delete-button" bindtap="deleteEntry">删除档案</button>
  </view>
</view>
