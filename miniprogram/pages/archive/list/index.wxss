.list-hero {
  padding: 32rpx;
  border-radius: 27rpx;
  color: #fff;
  background: linear-gradient(145deg, #24154f, #3a2675);
}

.hero-kicker {
  color: #d391ff;
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: #fff;
  font-size: 39rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.28);
}

.hero-desc {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.67);
  font-size: 20rpx;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 23rpx;
}

.add-button,
.import-button {
  flex: 1;
  margin: 0;
  border-radius: 16rpx;
  font-size: 21rpx;
  line-height: 72rpx;
}

.add-button {
  color: #24154f;
  background: #1b153b;
}

.import-button {
  color: #f0d9a7;
  background: rgba(255, 255, 255, 0.12);
}

.permission-note {
  margin: 18rpx 0;
  padding: 17rpx 20rpx;
  border-radius: 17rpx;
  color: #75674d;
  background: #2b2148;
  font-size: 18rpx;
}

.archive-event {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 20rpx;
  border-radius: 21rpx;
  background: #1b153b;
}

.event-cover {
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #e9ece9;
}

.event-date {
  flex: 0 0 82rpx;
  margin-right: 18rpx;
  text-align: center;
}

.date-day {
  color: #c982ff;
  font-family: serif;
  font-size: 37rpx;
  font-weight: 700;
}

.date-month {
  color: #9189a9;
  font-size: 15rpx;
}

.event-copy {
  flex: 1;
  min-width: 0;
}

.event-heading,
.event-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.event-title {
  overflow: hidden;
  color: #f7f3ff;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  flex: 0 0 auto;
  padding: 4rpx 9rpx;
  border-radius: 999rpx;
  font-size: 15rpx;
}

.status.published {
  color: #266453;
  background: #dfece6;
}

.status.draft {
  color: #9c6d26;
  background: #f5e8ce;
}

.event-summary {
  overflow: hidden;
  margin-top: 8rpx;
  color: #c8c0d8;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-meta {
  margin-top: 10rpx;
  color: #b4acc6;
  font-size: 16rpx;
}

.event-team {
  margin-top: 8rpx;
  color: #c982ff;
  font-size: 17rpx;
  font-weight: 700;
  text-align: right;
}

.arrow {
  margin-left: 10rpx;
  color: #abb4b0;
  font-size: 34rpx;
}
.entry-actions{display:flex;gap:20rpx;margin-top:12rpx;color:#7be4ff;font-size:17rpx}.entry-actions .delete{color:#ff8598}.add-button{color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd)}.permission-note{color:#c2b7d4;background:#211943}.status.published{color:#9ff2d4;background:#173d3a}.status.draft{color:#f6d78d;background:#4b3820}
