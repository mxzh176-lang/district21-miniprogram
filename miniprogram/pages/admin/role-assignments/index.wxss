.role-hero,.form-card,.setup-card,.assignment-card{padding:28rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:24rpx;background:#1b153b}.role-hero{background:linear-gradient(145deg,#6333a5,#224f91)}.hero-title{margin-top:10rpx;color:#fff;font-size:38rpx;font-weight:800}.hero-desc,.setup-desc{margin-top:8rpx;color:#aaa2bf;font-size:20rpx;line-height:1.6}.form-card,.setup-card{margin-top:22rpx}.setup-title,.assignment-position{color:#fff;font-size:26rpx;font-weight:700}.field-label{margin:24rpx 0 10rpx;color:#cbbbea;font-size:20rpx}.picker-value{padding:22rpx;border-radius:16rpx;color:#fff;background:#2a2050}.date-row{display:flex;gap:14rpx}.date-field{flex:1;min-width:0}.primary-button{margin-top:28rpx;color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd)}.section-title{margin:30rpx 0 16rpx}.assignment-card{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx}.assignment-user{margin-top:6rpx;color:#7be4ff;font-size:24rpx}.assignment-term{color:#aaa2bf;font-size:18rpx;text-align:right}.empty{padding:28rpx;color:#8f879e;text-align:center}
