<view class="page">
  <view class="card form">
    <view class="field">
      <text class="field-label">{{type === 'notice' ? '公告标题' : '记录标题'}}</text>
      <input class="input" value="{{form.title}}" data-key="title" bindinput="input" placeholder="请填写标题" />
    </view>
    <view wx:if="{{type === 'history'}}" class="field">
      <text class="field-label">年份</text>
      <input class="input" type="number" value="{{form.year}}" data-key="year" bindinput="input" placeholder="例如：2026" />
    </view>
    <view wx:if="{{type === 'notice'}}" class="field switch-row">
      <text class="field-label no-margin">置顶公告</text>
      <switch checked="{{form.pinned}}" color="#123b32" bindchange="changePinned"></switch>
    </view>
    <view class="field">
      <text class="field-label">正文内容</text>
      <textarea class="textarea long" value="{{form.content}}" data-key="content" bindinput="input" placeholder="内容可后续继续修改"></textarea>
    </view>
    <button class="primary-button" bindtap="save" loading="{{saving}}">保存</button>
    <button wx:if="{{id}}" class="danger-button delete" bindtap="remove">移入回收站</button>
  </view>
</view>
