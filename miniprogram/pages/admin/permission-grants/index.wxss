.grant-hero,.setup-card,.form-card,.grant-card{padding:28rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:24rpx;background:#1b153b}.grant-hero{background:linear-gradient(145deg,#6333a5,#224f91)}.hero-title{margin-top:10rpx;color:#fff;font-size:38rpx;font-weight:800}.hero-desc{margin-top:8rpx;color:#d7c8e8;font-size:20rpx;line-height:1.6}.setup-card,.form-card{margin-top:20rpx}.setup-title{color:#fff;font-size:26rpx;font-weight:800}.setup-desc{margin-top:8rpx;color:#cfc4df;line-height:1.6}.field-label{margin:20rpx 0 9rpx;color:#cbbbea;font-size:21rpx}.picker-value{padding:22rpx;border-radius:16rpx;color:#fff;background:#2a2050}.action-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13rpx}.action-grid label{display:flex;align-items:center;padding:18rpx;border-radius:14rpx;color:#ddd2ec;background:#261d49}.action-grid checkbox{transform:scale(.8)}.date-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.save-button{margin-top:28rpx;color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd)}.section-title{margin:30rpx 0 16rpx}.grant-card{margin-bottom:15rpx}.grant-head{display:flex;align-items:center;justify-content:space-between}.grant-user{color:#fff;font-size:27rpx;font-weight:800}.grant-org{margin-top:5rpx;color:#9d94b2;font-size:19rpx}.grant-summary{margin-top:17rpx;color:#7be4ff;font-size:23rpx;font-weight:700}.grant-actions{margin-top:8rpx;color:#d9cdea}.grant-term{margin-top:13rpx;color:#9188a8;font-size:18rpx}.revoke{padding:10rpx 15rpx;border-radius:999rpx;color:#ff9bad;background:rgba(127,45,71,.25)}.empty{padding:35rpx;color:#8f879e;text-align:center}
.identity-tip{margin-top:12rpx;padding:18rpx;border-radius:14rpx;color:#e5d7b4;background:#302542;font-size:20rpx;line-height:1.65}
.readonly-note{margin-top:20rpx;padding:20rpx;border-radius:16rpx;color:#d8cee6;background:#26203d;font-size:20rpx;line-height:1.6}
