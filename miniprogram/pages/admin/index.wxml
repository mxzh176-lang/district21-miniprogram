<view class="page">
  <view class="admin-hero">
    <view class="hero-kicker">INTERNAL MANAGEMENT</view>
    <view class="hero-title">协作区权限中心</view>
    <view class="hero-desc">四队共用数据，按届次与岗位分配权限</view>
  </view>

  <view class="stats-grid">
    <view class="stat-card"><view class="number">{{stats.memberCount}}</view><view>在册狮友</view></view>
    <view class="stat-card"><view class="number">{{stats.taskCount}}</view><view>本月待办</view></view>
    <view class="stat-card"><view class="number">{{stats.activityCount}}</view><view>示例档案</view></view>
    <view class="stat-card"><view class="number">{{stats.photoCount}}</view><view>年度照片</view></view>
  </view>

  <view class="section-title">成员授权码</view>
  <view class="invite-card">
    <view>
      <view class="invite-label">二十一协作区 · 普通成员</view>
      <view class="invite-code">{{inviteCode}}</view>
      <view class="invite-desc">有效期至 2026-06-30 · 可使用 50 次</view>
    </view>
    <button class="copy-button" bindtap="copyCode">复制</button>
  </view>
  <view class="security-note">授权码只用于首次绑定。正式权限由“成员 + 服务队 + 届次 + 岗位”决定。</view>

  <view class="section-row">
    <view class="section-title">2026—2027年度岗位</view>
    <view class="small-link" bindtap="goRoleAssignments">管理岗位 ›</view>
  </view>
  <view class="appointment-card" wx:for="{{appointments}}" wx:key="position">
    <view class="position-icon">{{index + 1}}</view>
    <view class="appointment-copy">
      <view class="position">{{item.position}}</view>
      <view class="person">{{item.person}} · {{item.organization}}</view>
    </view>
    <view class="permission">已授权</view>
  </view>

  <view class="section-title">页面内容管理</view>
  <view class="position-grant-entry" bindtap="goPermissionGrants">
    <view class="position-grant-head"><view class="manage-icon blue">岗</view><view><view class="position-grant-title">岗位与委员会管理员</view><view class="position-grant-desc">秘书、纠察、司库、总务及各委员会分别授权</view></view><view class="arrow">›</view></view>
    <view class="position-grant-chips"><text>查看</text><text>新增</text><text>修改</text><text>上传</text><text>删除</text></view>
  </view>
  <view class="manage-grid">
    <view class="manage-item" bindtap="goUserRoles"><view class="manage-icon blue">权</view><view>组织角色与总权限</view><text>角色、组织与期限</text></view>
    <view class="manage-item" bindtap="goTasks"><view class="manage-icon green">待</view><view>待办与服务</view><text>修改事项</text></view>
    <view class="manage-item" bindtap="goArchives"><view class="manage-icon red">档</view><view>档案与照片</view><text>编辑排序</text></view>
    <view class="manage-item" bindtap="goContacts"><view class="manage-icon gold">员</view><view>人员与企业</view><text>头像资料</text></view>
    <view class="manage-item" bindtap="goNotices"><view class="manage-icon blue">文</view><view>通知内容</view><text>文字编辑</text></view>
  </view>

  <view class="section-title">统一权限管理</view>
  <view class="position-grant-entry" bindtap="goUserRoles">
    <view class="position-grant-head"><view class="manage-icon blue">权</view><view><view class="position-grant-title">组织角色与用户权限</view><view class="position-grant-desc">与 Web 管理后台共用同一份云端权限，修改后立即同步</view></view><view class="arrow">›</view></view>
    <view class="position-grant-chips"><text>人员</text><text>服务队</text><text>岗位</text><text>模块</text><text>任期</text></view>
  </view>

  <view class="log-entry" bindtap="goLogs">
    <view><view class="log-title">管理员操作记录</view><view class="log-desc">查看新增、上传、权限变更与删除记录</view></view>
    <view class="arrow">›</view>
  </view>

  <view class="demo-footer">Web 后台与小程序统一读取 user_permissions、user_role 和岗位任期数据，不再使用旧管理员权限入口。</view>
</view>
