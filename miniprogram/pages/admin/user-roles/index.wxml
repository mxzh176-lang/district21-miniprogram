<view class="page">
  <view class="role-hero">
    <view class="hero-kicker">ROLE + PORT ACCESS</view>
    <view class="hero-title">用户与权限</view>
    <view class="hero-desc">先套用角色默认权限，再按端口微调；授权始终受组织、岗位和有效期限制。</view>
  </view>

  <view class="readonly-note" wx:if="{{!canEdit}}">当前为只读模式，只有超级管理员可修改授权。</view>
  <view class="setup-card" wx:if="{{setupRequired}}">请先在云开发数据库创建 user_permissions 集合，然后重新部署 api 云函数。</view>

  <view class="form-card" wx:if="{{canEdit && !loading}}">
    <view class="step"><text>1</text><view><view class="step-title">选择用户</view><picker range="{{users}}" range-key="displayName" value="{{userIndex}}" bindchange="onUserChange"><view class="picker-value">{{users.length ? users[userIndex].displayName : '暂无可授权用户'}}</view></picker></view></view>
    <view class="identity-tip" wx:if="{{incompleteUserCount}}">有 {{incompleteUserCount}} 人未填写姓名和所属组织，暂不能授权。</view>
    <view class="step"><text>2</text><view><view class="step-title">选择服务队</view><picker range="{{teams}}" range-key="name" value="{{teamIndex}}" bindchange="onTeamChange"><view class="picker-value">{{teams.length ? teams[teamIndex].name : '暂无服务队'}}</view></picker></view></view>
    <view class="step"><text>3</text><view><view class="step-title">选择角色</view><picker range="{{roles}}" range-key="name" value="{{roleIndex}}" bindchange="onRoleChange"><view class="picker-value">{{roles[roleIndex].name}}</view></picker><view class="preset-tip">已自动加载该角色默认权限</view></view></view>
    <view class="step"><text>4</text><view><view class="step-title">选择数据范围</view><picker range="{{dataScopes}}" range-key="label" value="{{scopeIndex}}" bindchange="onScopeChange"><view class="picker-value">{{dataScopes[scopeIndex].label}}</view></picker></view></view>
    <view class="step permissions-step"><text>5</text><view><view class="step-title">勾选具体端口权限</view><view class="preset-tip">以角色默认值为起点，可逐项开启或关闭</view></view></view>
    <view class="permission-group" wx:for="{{permissionGroups}}" wx:key="module">
      <view class="group-head" data-module="{{item.module}}" bindtap="toggleGroup"><view>{{item.label}} <text>{{item.selectedCount}} 项</text></view><text>{{item.expanded ? '−' : '+'}}</text></view>
      <checkbox-group wx:if="{{item.expanded}}" class="permission-grid" data-module="{{item.module}}" bindchange="onPermissionChange">
        <label wx:for="{{item.actions}}" wx:for-item="action" wx:key="value"><checkbox value="{{action.value}}" checked="{{action.checked}}" color="#4b74d9" /><text>{{action.label}}</text></label>
      </checkbox-group>
    </view>
    <view class="step"><text>6</text><view><view class="step-title">设置有效期</view><view class="date-row"><picker mode="date" value="{{startDate}}" bindchange="onStartDateChange"><view class="picker-value">{{startDate}}</view></picker><picker mode="date" value="{{endDate}}" bindchange="onEndDateChange"><view class="picker-value">{{endDate}}</view></picker></view></view></view>
    <button class="save-button" disabled="{{!users.length || !teams.length}}" bindtap="savePermissions">{{editingId ? '保存授权修改' : '保存用户授权'}}</button>
  </view>

  <view class="section-title">已配置授权</view>
  <view class="grant-card" wx:for="{{grants}}" wx:key="id">
    <view><view class="user-name">{{item.userName}}</view><view class="grant-meta">{{item.teamName}} · {{item.roleName}}</view><view class="grant-meta">{{item.scopeName}} · {{item.startDate}} 至 {{item.endDate}}</view></view>
    <view class="grant-actions" wx:if="{{canEdit}}"><text data-id="{{item.id}}" bindtap="editGrant">编辑</text><text class="danger" data-id="{{item.id}}" bindtap="revokeGrant">删除</text></view>
  </view>
  <view class="empty" wx:if="{{!loading && !grants.length}}">暂无 user_permissions 授权记录。</view>
</view>
