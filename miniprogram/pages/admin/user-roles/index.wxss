.role-hero,.steps-card,.form-card,.role-card{padding:28rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:24rpx;background:#1b153b}.role-hero{background:linear-gradient(145deg,#6333a5,#224f91)}.hero-title{margin-top:10rpx;color:#fff;font-size:38rpx;font-weight:800}.hero-desc{margin-top:8rpx;color:#d7c8e8;font-size:20rpx;line-height:1.6}.steps-card,.form-card{margin-top:20rpx;color:#cfc4df;font-size:21rpx;line-height:1.9}.label{margin:18rpx 0 8rpx;color:#cbbbea}.picker-value{padding:22rpx;border-radius:16rpx;color:#fff;background:#2a2050}.save-button{margin-top:28rpx;color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd)}.section-title{margin:30rpx 0 16rpx}.role-card{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx}.user-name{color:#fff;font-size:26rpx;font-weight:700}.role-name{margin-top:7rpx;color:#7be4ff;font-size:19rpx}.revoke{padding:12rpx;color:#ff9b9b}.empty{padding:36rpx;color:#8f879e;text-align:center}
.identity-tip{margin-top:12rpx;padding:18rpx;border-radius:14rpx;color:#e5d7b4;background:#302542;font-size:20rpx;line-height:1.65}
.permission-nav{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:20rpx}.permission-link{display:flex;align-items:center;justify-content:space-between;padding:22rpx;border:1rpx solid rgba(123,228,255,.2);border-radius:16rpx;color:#fff;background:#211a43}.permission-link text{color:#7be4ff}.readonly-note{margin-top:20rpx;padding:20rpx;border-radius:16rpx;color:#d8cee6;background:#26203d;font-size:20rpx}.date-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.date-field{min-width:0}.role-term{margin-top:6rpx;color:#9188a8;font-size:18rpx}
.code-input{color:#fff;-webkit-text-fill-color:#fff}.code-placeholder{color:#8f87a1;-webkit-text-fill-color:#8f87a1}
