.role-hero,.form-card,.grant-card,.setup-card{padding:28rpx;border:1rpx solid rgba(93,116,184,.22);border-radius:16rpx;background:#171b2d}.role-hero{background:linear-gradient(145deg,#56339b,#2865a5)}.hero-title{margin-top:10rpx;color:#fff;font-size:38rpx;font-weight:800}.hero-desc{margin-top:8rpx;color:#e0e5f2;font-size:20rpx;line-height:1.65}.readonly-note,.setup-card{margin-top:20rpx;color:#d8deea;font-size:20rpx;line-height:1.6}.form-card{margin-top:20rpx;color:#d8deea}.step{display:grid;grid-template-columns:52rpx minmax(0,1fr);gap:16rpx;margin-top:30rpx}.step:first-child{margin-top:0}.step>text{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;border-radius:50%;color:#fff;background:#4b74d9;font-size:20rpx;font-weight:800}.step-title{margin-bottom:12rpx;color:#fff;font-size:25rpx;font-weight:750}.picker-value{overflow:hidden;padding:21rpx;border:1rpx solid rgba(141,158,207,.22);border-radius:12rpx;color:#fff;background:#222943;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.identity-tip,.preset-tip{margin-top:10rpx;color:#aeb8d0;font-size:18rpx;line-height:1.55}.identity-tip{padding:16rpx;border-radius:12rpx;background:#29263d;color:#e6d6ae}.permissions-step{margin-bottom:14rpx}.permission-group{border-top:1rpx solid rgba(151,164,200,.16)}.group-head{display:flex;align-items:center;justify-content:space-between;padding:22rpx 4rpx;color:#f5f7fb;font-size:23rpx;font-weight:700}.group-head view text{margin-left:8rpx;color:#7fc6d9;font-size:18rpx;font-weight:500}.permission-grid{display:grid;grid-template-columns:1fr 1fr;gap:10rpx;padding:0 0 20rpx}.permission-grid label{display:flex;align-items:center;min-height:66rpx;padding:8rpx 12rpx;border-radius:10rpx;color:#d4dbea;background:#20263b;font-size:19rpx}.permission-grid checkbox{flex:none;transform:scale(.78)}.date-row{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.save-button{margin-top:30rpx;border-radius:12rpx;color:#fff;background:#4b74d9;font-size:23rpx;font-weight:750}.section-title{margin:32rpx 0 16rpx;color:#fff;font-weight:750}.grant-card{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:14rpx}.user-name{color:#fff;font-size:25rpx;font-weight:750}.grant-meta{margin-top:6rpx;color:#aab4ca;font-size:18rpx}.grant-actions{display:flex;gap:16rpx;flex:none;color:#7fc6d9;font-size:20rpx}.grant-actions .danger{color:#ff9aab}.empty{padding:36rpx;color:#8f99b0;text-align:center}
