<view class="page todo-editor">
  <view class="editor-hero">
    <view class="hero-kicker">YUANHANG TODO</view>
    <view class="hero-title">{{id ? '编辑待办' : '发布共享提醒'}}</view>
    <view class="hero-desc">远航服务队内部待办，成员共同查看与提醒</view>
  </view>

  <view class="form-card">
    <view class="field">
      <text class="field-label">事项内容 <text class="required">*</text></text>
      <textarea class="todo-content" value="{{form.title}}" data-key="title" bindinput="input" maxlength="100" placeholder="请输入需要提醒的事项" placeholder-class="todo-placeholder" cursor-color="#1456f0" always-embed="{{true}}"></textarea>
      <view class="field-tip">{{form.title.length || 0}} / 100</view>
    </view>

    <view class="field">
      <text class="field-label">日期 <text class="required">*</text></text>
      <picker mode="date" value="{{form.date}}" bindchange="changeDate">
        <view class="select-control">
          <text>{{form.date || '请选择日期'}}</text>
          <text class="select-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field last-field">
      <text class="field-label">类型</text>
      <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="changeCategory">
        <view class="select-control">
          <text>{{categories[categoryIndex]}}</text>
          <text class="select-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <button class="publish-button" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{id ? '保存修改' : '发布'}}</button>
  <button wx:if="{{id && canDelete}}" class="delete-button" bindtap="remove">删除待办</button>
</view>
