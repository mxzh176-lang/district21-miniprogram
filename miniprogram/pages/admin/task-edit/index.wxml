<view class="page">
  <view class="card form">
    <view class="field">
      <text class="field-label">事项名称</text>
      <input class="input" value="{{form.title}}" data-key="title" bindinput="input" placeholder="例如：圆梦助学活动" />
    </view>
    <view class="field">
      <text class="field-label">月份</text>
      <picker mode="date" fields="month" value="{{form.month}}" bindchange="changeMonth">
        <view class="picker">{{form.month || '选择月份'}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">日期</text>
      <input class="input" value="{{form.day}}" data-key="day" bindinput="input" placeholder="例如：14" type="number" />
    </view>
    <view class="field">
      <text class="field-label">档案分类模板</text>
      <picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="changeCategory">
        <view class="picker">{{categories[categoryIndex].label}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">展示类别</text>
      <input class="input" value="{{form.category}}" data-key="category" bindinput="input" placeholder="公益服务、会议纪要、对外交流等" />
    </view>
    <view class="field">
      <text class="field-label">负责人</text>
      <input class="input" value="{{form.owner}}" data-key="owner" bindinput="input" placeholder="负责人姓名" />
    </view>
    <view class="field">
      <text class="field-label">地点</text>
      <input class="input" value="{{form.location}}" data-key="location" bindinput="input" placeholder="活动或会议地点" />
    </view>
    <view class="field">
      <text class="field-label">状态</text>
      <picker range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="changeStatus">
        <view class="picker">{{statuses[statusIndex].label}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">详细说明</text>
      <textarea class="textarea" value="{{form.description}}" data-key="description" bindinput="input" placeholder="时间、地点和注意事项"></textarea>
    </view>
    <button class="secondary-button" bindtap="generateDraft">按分类生成嘉许模板</button>
    <button class="primary-button" bindtap="save" loading="{{saving}}">保存</button>
    <button wx:if="{{id}}" class="danger-button delete" bindtap="remove">移入回收站</button>
  </view>
</view>
