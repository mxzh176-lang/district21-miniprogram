.todo-editor {
  padding-bottom: 64rpx;
}

.editor-hero {
  padding: 34rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(145deg, #201447, #315f9d);
  box-shadow: 0 16rpx 40rpx rgba(31, 54, 104, .18);
}

.hero-kicker {
  color: #7be4ff;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 12rpx;
  font-family: serif;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, .72);
  font-size: 21rpx;
}

.form-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #e8ebf2;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(31, 35, 41, .07);
}

.field {
  margin-bottom: 28rpx;
}

.last-field {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #1f2329;
  font-size: 25rpx;
  font-weight: 700;
}

.required {
  color: #d84a3a;
}

.todo-content,
.select-control {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #dfe3eb;
  border-radius: 18rpx;
  color: #1f2329;
  background: #f8f9fb;
}

.todo-content {
  min-height: 184rpx;
  padding: 22rpx 24rpx;
  -webkit-text-fill-color: #1f2329;
  caret-color: #1456f0;
  font-size: 28rpx;
  line-height: 1.55;
}

.todo-placeholder,
.select-placeholder {
  color: #9aa0aa !important;
  -webkit-text-fill-color: #9aa0aa !important;
}

.field-tip {
  margin-top: 8rpx;
  color: #9aa0aa;
  font-size: 20rpx;
  text-align: right;
}

.select-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
}

.select-arrow {
  color: #8b94a6;
  font-size: 36rpx;
}

.publish-button,
.delete-button {
  margin-top: 24rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.publish-button {
  color: #fff;
  background: linear-gradient(135deg, #3370ff, #1456f0);
  box-shadow: 0 12rpx 28rpx rgba(20, 86, 240, .22);
}

.publish-button[disabled] {
  opacity: .68;
}

.delete-button {
  color: #b13d32;
  background: #fff0ed;
}
