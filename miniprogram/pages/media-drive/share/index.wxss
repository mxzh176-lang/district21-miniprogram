.page{min-height:100vh;padding:80rpx 28rpx;box-sizing:border-box;background:#f7f8fa;color:#1f2329}.share-card,.state-card{padding:48rpx 34rpx;border:1rpx solid #e8eaf0;border-radius:28rpx;background:#fff;text-align:center;box-shadow:0 16rpx 42rpx rgba(31,35,41,.07)}.share-icon{display:flex;align-items:center;justify-content:center;width:110rpx;height:110rpx;margin:0 auto;border-radius:32rpx;color:#fff;background:linear-gradient(135deg,#1456f0,#7b7df7);font-size:38rpx;font-weight:900}.share-kicker{margin-top:28rpx;color:#1456f0;font-size:20rpx;font-weight:800;letter-spacing:2rpx}.share-title{margin-top:12rpx;font-size:38rpx;font-weight:900}.share-meta{margin-top:12rpx;color:#8f959e;font-size:21rpx}.open-button{margin-top:38rpx;border-radius:20rpx;color:#fff;background:#1456f0;font-size:27rpx;font-weight:800}.state-card{color:#8f959e}.state-card.error{color:#b74242;background:#fff0ee}
