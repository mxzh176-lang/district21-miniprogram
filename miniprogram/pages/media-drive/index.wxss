.page{min-height:100vh;padding:24rpx 24rpx 140rpx;box-sizing:border-box;background:#f7f8fa;color:#1f2329}
.drive-hero{padding:34rpx;border-radius:28rpx;color:#fff;background:radial-gradient(circle at 86% 12%,rgba(255,255,255,.35),transparent 30%),linear-gradient(135deg,#3370ff,#7b7df7);box-shadow:0 18rpx 42rpx rgba(20,86,240,.14)}
.hero-kicker{font-size:18rpx;letter-spacing:3rpx;opacity:.78}
.hero-title{margin-top:12rpx;font-size:42rpx;font-weight:900}
.hero-desc{margin-top:8rpx;font-size:21rpx;opacity:.78}
.live-status{display:flex;align-items:center;margin-top:16rpx;font-size:18rpx;opacity:.82}
.live-dot{width:13rpx;height:13rpx;margin-right:9rpx;border-radius:50%;background:#58e29b;box-shadow:0 0 0 6rpx rgba(88,226,155,.16)}
.live-dot.syncing{background:#fff;animation:live-pulse 1s infinite}
.team-picker{display:flex;justify-content:space-between;margin-top:18rpx;padding:24rpx;border:1rpx solid #e8eaf0;border-radius:22rpx;background:#fff;font-size:25rpx;font-weight:800}
.team-picker text{color:#1456f0}
.category-scroll{margin:24rpx 0;white-space:nowrap}
.category-row{display:inline-flex;gap:12rpx;padding-right:24rpx}
.category-chip{padding:14rpx 24rpx;border:1rpx solid #e8eaf0;border-radius:999rpx;color:#646a73;background:#fff;font-size:22rpx}
.category-chip.active{border-color:#1456f0;color:#fff;background:#1456f0}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:8rpx 0 18rpx}
.section-title{font-size:32rpx;font-weight:900}
.section-desc{margin-top:4rpx;color:#8f959e;font-size:20rpx}
.upload-action{padding:13rpx 22rpx;border-radius:999rpx;color:#fff;background:#1456f0;font-size:22rpx;font-weight:800}
.album-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}
.album-card{overflow:hidden;border:1rpx solid #eef0f5;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(31,35,41,.06)}
.album-cover,.album-placeholder{width:100%;height:220rpx}
.album-placeholder{display:flex;align-items:center;justify-content:center;color:#1456f0;background:linear-gradient(135deg,#eff4ff,#eef0ff)}
.album-placeholder text{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:50%;background:#fff;font-size:30rpx;font-weight:900}
.album-body{padding:20rpx}
.album-category{color:#1456f0;font-size:18rpx;font-weight:800}
.album-title{margin-top:8rpx;overflow:hidden;font-size:27rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}
.album-meta{margin-top:9rpx;color:#8f959e;font-size:18rpx}
.empty,.loading,.error-card{padding:50rpx 24rpx;border-radius:22rpx;text-align:center;background:#fff;color:#8f959e}
.error-card{color:#b74242;background:#fff0ee}
.mask{position:fixed;z-index:20;inset:0;background:rgba(0,0,0,.42)}
.upload-sheet{position:fixed;z-index:21;right:0;bottom:0;left:0;padding:32rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#fff}
.sheet-title{font-size:34rpx;font-weight:900}
.field-label{margin:24rpx 0 10rpx;color:#646a73;font-size:21rpx}
.field-input{box-sizing:border-box;width:100%;min-height:84rpx;padding:23rpx 24rpx;border:1rpx solid #e8eaf0;border-radius:18rpx;color:#1f2329;-webkit-text-fill-color:#1f2329;background:#f7f8fa;font-size:25rpx}
.field-placeholder{color:#a7abb2;-webkit-text-fill-color:#a7abb2}
.queue-head{display:flex;align-items:flex-end;justify-content:space-between;margin-top:20rpx}
.queue-label{margin-bottom:2rpx}
.queue-summary{color:#8f959e;font-size:20rpx}
.queue-add{padding:12rpx 18rpx;border-radius:999rpx;color:#1456f0;background:#eff4ff;font-size:21rpx;font-weight:800}
.queue-list{max-height:260rpx;margin-top:14rpx;border:1rpx solid #eef0f5;border-radius:18rpx}
.queue-item{display:flex;align-items:center;gap:14rpx;padding:12rpx;border-bottom:1rpx solid #f0f1f4}
.queue-item:last-child{border-bottom:0}
.queue-thumb{width:66rpx;height:66rpx;border-radius:12rpx;background:#eef0f5}
.queue-name{flex:1;color:#646a73;font-size:21rpx}
.queue-remove{color:#d94f65;font-size:20rpx}
.queue-empty{margin-top:14rpx;padding:28rpx;border:2rpx dashed #cbd8ff;border-radius:18rpx;color:#1456f0;background:#f6f8ff;text-align:center;font-size:22rpx}
.primary-button,.cancel-button{margin-top:24rpx;border-radius:20rpx;font-size:27rpx;font-weight:800}
.primary-button{color:#fff;background:#1456f0}
.cancel-button{color:#646a73;background:#f2f3f5}
.upload-progress{margin-top:20rpx;color:#1456f0;text-align:center;font-size:22rpx}
@keyframes live-pulse{0%,100%{opacity:.45}
50%{opacity:1}
}
