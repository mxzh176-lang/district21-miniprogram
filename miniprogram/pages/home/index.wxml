<view class="page">
  <view class="scope-bar" bindtap="chooseOrgScope">
    <view>
      <view class="scope-kicker">当前范围</view>
      <view class="scope-name">{{currentOrg.orgName}}</view>
    </view>
    <view class="scope-action">切换 ▼</view>
  </view>

  <swiper class="hero-swiper" autoplay circular indicator-dots interval="3500">
    <swiper-item wx:for="{{heroSlides}}" wx:key="key">
      <view wx:if="{{item.type === 'intro'}}" class="hero">
        <view class="hero-top">
          <view>
            <view class="eyebrow">LIONS DISTRICT 21 · SUIHUA</view>
            <view class="hero-title org-title"><text>{{currentOrg.orgName}}</text></view>
            <view class="hero-subtitle">二一聚力 · 再创佳绩</view>
          </view>
          <view class="hero-seal">21</view>
        </view>
        <view class="term-row">
          <view>2026—2027年度</view>
          <view class="demo-tag">四队同心</view>
        </view>
      </view>
      <image wx:else src="{{item.src}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="feature-entry honor-entry" bindtap="goHonors">
    <view class="feature-icon honor-icon">誉</view>
    <view class="feature-copy">
      <view class="feature-title">{{honorTitle}}</view>
      <view class="feature-desc">总览目标、达成进度与表彰记录</view>
    </view>
    <view class="arrow">›</view>
  </view>

  <view class="feature-entry archive-entry" bindtap="goArchive">
    <view class="feature-icon archive-icon">档</view>
    <view class="feature-copy">
      <view class="feature-title">{{archiveTitle}}</view>
      <view class="feature-desc">{{archiveDesc}}</view>
    </view>
    <view class="arrow">›</view>
  </view>

  <view class="section-row">
    <view>
      <view class="section-kicker">JUNE PLAN</view>
      <view class="section-title compact">{{monthLabel}}重点待办</view>
    </view>
    <view class="task-heading-actions">
      <view wx:if="{{canCreateTask}}" class="quick-add" bindtap="createTask">＋</view>
      <view class="more" bindtap="goTasks">全部 {{homePendingCount}} 项 ›</view>
    </view>
  </view>

  <view class="home-task-module">
    <todo-group-section
      wx:for="{{homeTaskGroups}}"
      wx:key="key"
      group="{{item}}"
      compact="{{true}}"
      bind:open="openTask"
      bind:complete="completeTask"
    />
    <view wx:if="{{homeHasMore}}" class="task-view-all" bindtap="goTasks">还有 {{homePendingCount - homeVisibleCount}} 项待办，查看全部 ›</view>
    <view wx:if="{{!homeTaskGroups.length}}" class="home-task-empty" bindtap="goTasks">本月暂无待办，点击进入重点待办</view>
  </view>

  <view class="care-row">
    <view class="care-card birthday" bindtap="goBirthdays">
      <view class="care-icon">生</view>
      <view>
        <view class="care-label">本月生日</view>
        <view class="care-value">{{careOverview.birthdayCount}}位狮友</view>
      </view>
      <view class="care-arrow">›</view>
    </view>
    <view class="care-card concern" bindtap="goMonthlyService">
      <view class="care-icon">爱</view>
      <view>
        <view class="care-label">本月服务</view>
        <view class="care-value">查看服务事件</view>
      </view>
      <view class="care-arrow">›</view>
    </view>
  </view>

  <view class="stats">
    <view class="stat" bindtap="goContacts">
      <view class="stat-number">{{summary.memberCount}}</view>
      <view class="stat-label">{{currentOrg.orgType === 'district' ? '协作区总人数' : '服务队人数'}}</view>
    </view>
    <view class="stat">
      <view class="stat-number">{{currentOrg.orgType === 'district' ? 4 : 1}}</view>
      <view class="stat-label">{{currentOrg.orgType === 'district' ? '服务队统计' : '当前服务队'}}</view>
    </view>
    <view class="stat">
      <view class="stat-number">{{summary.photoCount}}</view>
      <view class="stat-label">年度照片</view>
    </view>
  </view>

  <view class="section-row">
    <view class="section-title compact">{{historyTitle}}</view>
    <view class="more" bindtap="goActivities">查看历史 ›</view>
  </view>
  <scroll-view scroll-x class="event-scroll">
    <view class="event-row">
      <view class="event-card tone-{{item.tone}}" wx:for="{{activities}}" wx:key="_id" data-id="{{item._id}}" bindtap="openActivity">
        <view class="event-mark">{{item.mark}}</view>
        <view class="event-date">{{item.dateLabel}}</view>
        <view class="event-title">{{item.title}}</view>
        <view class="event-team">{{item.team}} · {{item.photoCount}}张照片</view>
      </view>
    </view>
  </scroll-view>

  <view class="notice-bar" wx:if="{{notices.length}}" bindtap="goNotices">
    <view class="notice-icon">告</view>
    <view class="notice-copy">
      <view class="notice-title">{{notices[0].title}}</view>
      <view class="notice-content">{{notices[0].content}}</view>
    </view>
    <view class="arrow">›</view>
  </view>

</view>
