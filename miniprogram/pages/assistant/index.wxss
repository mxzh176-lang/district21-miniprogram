.assistant-page{display:flex;flex-direction:column;height:100vh;padding:24rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));background:#0b1024;box-sizing:border-box}
.assistant-hero{display:flex;align-items:center;padding:24rpx;border:1rpx solid rgba(211,145,255,.3);border-radius:24rpx;background:linear-gradient(135deg,#6333a5,#224f91)}.assistant-mark,.avatar{display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;background:linear-gradient(145deg,#b464f1,#347fde)}.assistant-mark{flex:0 0 76rpx;width:76rpx;height:76rpx;margin-right:18rpx;border-radius:22rpx;font-size:28rpx}.hero-copy{flex:1;min-width:0}.hero-title{color:#fff;font-size:30rpx;font-weight:700}.hero-desc{margin-top:6rpx;color:rgba(255,255,255,.7);font-size:18rpx;line-height:1.5}.clear{padding:10rpx;color:#e9d2ff;font-size:20rpx}
.suggestion-scroll{flex:0 0 auto;margin:18rpx 0;white-space:nowrap}.suggestion-row{display:inline-flex;gap:12rpx}.suggestion{padding:11rpx 18rpx;border:1rpx solid rgba(201,130,255,.2);border-radius:999rpx;color:#d9cfe8;background:#211943;font-size:19rpx}
.message-list{flex:1;min-height:0}.message-row{display:flex;align-items:flex-start;margin-bottom:22rpx}.message-row.user{flex-direction:row-reverse}.avatar{flex:0 0 60rpx;width:60rpx;height:60rpx;border-radius:18rpx;font-size:20rpx}.message-row.assistant .avatar{margin-right:14rpx}.message-row.user .avatar{margin-left:14rpx;background:#315c9e}.message-content{max-width:78%}.bubble{padding:19rpx 22rpx;border:1rpx solid rgba(201,130,255,.16);border-radius:8rpx 22rpx 22rpx;color:#f4f0ff;background:#1b153b;font-size:23rpx;line-height:1.75;white-space:pre-wrap}.user .bubble{border-color:rgba(95,170,255,.25);border-radius:22rpx 8rpx 22rpx 22rpx;background:#254d87}.loading{color:#c7bdd8}
.sources{margin-top:10rpx;padding:16rpx;border-radius:17rpx;background:#171231}.source-title{margin-bottom:9rpx;color:#9f97b6;font-size:17rpx}.source-item{display:flex;align-items:center;gap:12rpx;padding:10rpx 0;border-top:1rpx solid rgba(201,130,255,.12)}.source-copy{flex:1;min-width:0}.source-name{color:#eee8f8;font-size:19rpx;font-weight:700}.source-from{margin-top:3rpx;overflow:hidden;color:#9f97b6;font-size:16rpx;text-overflow:ellipsis;white-space:nowrap}.copy-source{flex:0 0 auto;color:#7be4ff;font-size:17rpx}
.composer{display:flex;align-items:flex-end;gap:13rpx;padding-top:16rpx;border-top:1rpx solid rgba(201,130,255,.14)}.question-input{flex:1;min-height:76rpx;max-height:180rpx;padding:19rpx 22rpx;border:2rpx solid rgba(211,145,255,.34);border-radius:20rpx;color:#fff;background:#171231;box-sizing:border-box;font-size:24rpx;font-weight:600;line-height:1.5}.question-placeholder{color:#aaa2bf}.send-button{flex:0 0 124rpx;margin:0;border-radius:20rpx;color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd);font-size:23rpx;line-height:78rpx}.send-button[disabled]{color:#7f7892;background:#29223f}
