<view class="assistant-page">
  <view class="assistant-hero">
    <view class="assistant-mark">AI</view>
    <view class="hero-copy">
      <view class="hero-title">二十一协作区 AI 助手</view>
      <view class="hero-desc">连接狮子会知识库，只回答有来源的内部学习与服务问题</view>
    </view>
    <view class="clear" bindtap="clearChat">清空</view>
  </view>

  <scroll-view scroll-x class="suggestion-scroll">
    <view class="suggestion-row">
      <view class="suggestion" wx:for="{{suggestions}}" wx:key="*this"
        data-question="{{item}}" bindtap="useSuggestion">{{item}}</view>
    </view>
  </scroll-view>

  <scroll-view scroll-y class="message-list" scroll-into-view="{{scrollTo}}">
    <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}"
      class="message-row {{item.role}}">
      <view class="avatar">{{item.role === 'assistant' ? 'AI' : '我'}}</view>
      <view class="message-content">
        <view class="bubble">{{item.content}}</view>
        <view wx:if="{{item.sources.length}}" class="sources">
          <view class="source-title">参考资料</view>
          <view wx:for="{{item.sources}}" wx:key="title" class="source-item">
            <view class="source-copy">
              <view class="source-name">{{item.title}}</view>
              <view class="source-from">{{item.sourceName}}</view>
            </view>
            <view wx:if="{{item.sourceUrl}}" class="copy-source" data-url="{{item.sourceUrl}}"
              catchtap="copySource">复制链接</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{sending}}" class="message-row assistant">
      <view class="avatar">AI</view>
      <view class="bubble loading">正在查找知识库...</view>
    </view>
  </scroll-view>

  <view class="composer">
    <textarea class="question-input" auto-height maxlength="300" value="{{question}}"
      bindinput="inputQuestion" confirm-type="send" bindconfirm="send"
      placeholder="输入你的问题" placeholder-class="question-placeholder"
      placeholder-style="color:#aaa2bf;" />
    <button class="send-button" loading="{{sending}}" disabled="{{sending || !question}}"
      bindtap="send">发送</button>
  </view>
</view>
