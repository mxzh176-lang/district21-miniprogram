.history-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(145deg, #201447, #3a2675);
}

.year-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border: 3rpx solid #d391ff;
  border-radius: 50%;
  color: #e4c78e;
  font-family: serif;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-title {
  color: #fff;
  font-family: serif;
  font-size: 39rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.28);
}

.hero-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
}

.team-scroll {
  margin: 22rpx 0 16rpx;
  white-space: nowrap;
}

.team-filters {
  display: inline-flex;
  gap: 11rpx;
}

.team-filter {
  padding: 11rpx 20rpx;
  border-radius: 999rpx;
  color: #aaa2bf;
  background: #211943;
  font-size: 20rpx;
}

.team-filter.active {
  color: #fff;
  background: #201447;
}

.source-note {
  display: flex;
  align-items: center;
  padding: 19rpx;
  border-radius: 18rpx;
  color: #c3b1d5;
  background: #2b2148;
  font-size: 19rpx;
  line-height: 1.55;
}

.source-icon {
  display: flex;
  flex: 0 0 52rpx;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  color: #fff;
  background: #9b5de5;
  font-weight: 700;
}

.timeline {
  margin-top: 24rpx;
}

.timeline-item {
  display: flex;
}

.date-column {
  flex: 0 0 98rpx;
  padding-top: 22rpx;
  text-align: right;
}

.date-year {
  color: #c982ff;
  font-family: serif;
  font-size: 22rpx;
  font-weight: 700;
}

.date-day {
  margin-top: 3rpx;
  color: #9189a9;
  font-size: 18rpx;
}

.line-column {
  position: relative;
  flex: 0 0 42rpx;
}

.dot-main {
  position: absolute;
  top: 28rpx;
  left: 9rpx;
  z-index: 2;
  width: 17rpx;
  height: 17rpx;
  border: 5rpx solid #0b1024;
  border-radius: 50%;
  background: #9b5de5;
}

.line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 20rpx;
  width: 2rpx;
  background: #d8c59e;
}

.event-card {
  flex: 1;
  margin-bottom: 17rpx;
  padding: 23rpx;
  border-radius: 22rpx;
  background: #1b153b;
}

.event-type {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #d7a8ff;
  background: #2d2050;
  font-size: 17rpx;
}

.event-title {
  margin-top: 10rpx;
  color: #f7f3ff;
  font-size: 27rpx;
  font-weight: 700;
}

.event-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: #c8c0d8;
  font-size: 20rpx;
  line-height: 1.6;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.event-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 13rpx;
  border-top: 1rpx solid rgba(201,130,255,.16);
  color: #b4acc6;
  font-size: 18rpx;
}

.team-name {
  color: #c982ff;
  font-weight: 700;
}

.event-footer-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.delete-event {
  padding: 5rpx 12rpx;
  border: 1rpx solid rgba(255, 133, 152, 0.48);
  border-radius: 999rpx;
  color: #ff9bad;
  background: rgba(127, 45, 71, 0.28);
  font-weight: 700;
}

.history-hero {
  border: 1rpx solid rgba(211, 145, 255, 0.32);
  background:
    radial-gradient(circle at 90% 10%, rgba(99, 215, 255, 0.2), transparent 30%),
    linear-gradient(145deg, #6333a5, #224f91);
  box-shadow: 0 20rpx 52rpx rgba(55, 20, 116, 0.32);
}

.year-mark {
  border-color: #d391ff;
  color: #e8c4ff;
  box-shadow: 0 0 30rpx rgba(211, 145, 255, 0.24);
}

.team-filter {
  border: 1rpx solid rgba(201, 130, 255, 0.12);
  color: #aaa2bf;
  background: rgba(31, 24, 65, 0.86);
}

.team-filter.active {
  color: #fff;
  background: linear-gradient(135deg, #a15be8, #377ddd);
}

.source-note,
.event-card {
  border: 1rpx solid rgba(201, 130, 255, 0.16);
  color: #bdb4d1;
  background: rgba(27, 21, 59, 0.88);
}

.source-icon,
.dot-main {
  background: #a05ce7;
}

.dot-main {
  border-color: #0b1024;
  box-shadow: 0 0 20rpx rgba(211, 145, 255, 0.7);
}

.line {
  background: linear-gradient(#a05ce7, rgba(99, 166, 230, 0.18));
}

.event-type {
  color: #e0b9ff;
  background: rgba(151, 86, 218, 0.22);
}
