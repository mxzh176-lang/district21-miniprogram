<view class="page">
  <view class="scope-card" bindtap="chooseOrgScope">
    <view>
      <view class="scope-kicker">当前范围</view>
      <view class="scope-name">{{currentScope.orgName || '二十一协作区'}}</view>
    </view>
    <view class="scope-switch">切换 ▼</view>
  </view>

  <view class="profile-hero">
    <view class="avatar">21</view>
    <view class="name">{{member.nickname}}</view>
    <view class="role">{{member.displayRole}} · {{member.term}}</view>
    <view class="organization">{{member.team}}</view>
    <view class="organization" bindtap="copyUserId">成员编号：{{member.displayCode}}</view>
  </view>
  <view class="identity-warning" wx:if="{{needsProfile}}">
    <view class="identity-warning-title">尚未完成内部身份资料</view>
    <view class="identity-warning-text">填写姓名和所属组织后，管理员才能识别你并分配权限。</view>
  </view>
  <button class="reconnect-button" bindtap="editProfile">{{needsProfile ? '立即完善内部身份资料' : '修改内部身份资料'}}</button>

  <view class="demo-note">
    <view class="demo-icon">内</view>
    <view>
      <view class="demo-title">组织内部资料管理工具</view>
      <view class="demo-desc">按组织、岗位和任期控制权限，不提供用户公开发表、评论、转发或社交互动。</view>
    </view>
  </view>
  <button wx:if="{{member.status === 'readonly'}}" class="reconnect-button" bindtap="retryCloud">重新连接云端</button>

  <view class="section-title">协作区资料</view>
  <view class="menu-card" bindtap="goNotices">
    <view class="menu-icon gold">告</view>
    <view class="menu-copy"><view class="menu-title">通知公告</view><view class="menu-desc">岗位交接与公益服务通知</view></view>
    <view class="arrow">›</view>
  </view>
  <view class="menu-card" bindtap="goKnowledge">
    <view class="menu-icon knowledge">知</view>
    <view class="menu-copy"><view class="menu-title">中国狮子联会知识库</view><view class="menu-desc">官方资料、制度索引与服务知识</view></view>
    <view class="arrow">›</view>
  </view>
  <view class="menu-card" bindtap="goHistory">
    <view class="menu-icon green">史</view>
    <view class="menu-copy"><view class="menu-title">协作区与四队发展历史</view><view class="menu-desc">按年份保存重要服务与里程碑</view></view>
    <view class="arrow">›</view>
  </view>
  <view wx:if="{{!needsProfile && member.status === 'approved' && canViewPermissions}}" class="menu-card" bindtap="goUserPermissions">
    <view class="menu-icon blue">管</view>
    <view class="menu-copy"><view class="menu-title">用户与权限</view><view class="menu-desc">查看角色、岗位、模块和授权期限</view></view>
    <view class="arrow">›</view>
  </view>
  <view wx:if="{{canManage}}" class="menu-card" bindtap="goAdmin">
    <view class="menu-icon blue">管</view>
    <view class="menu-copy"><view class="menu-title">权限中心</view><view class="menu-desc">届次岗位、内部内容和操作日志</view></view>
    <view class="arrow">›</view>
  </view>

  <view class="privacy-card">
    <view class="privacy-title">内部资料保护</view>
    <view class="privacy-text">系统仅保存内部成员识别与岗位授权所需资料；关爱隐私、电话、企业与地址等非必要信息不在成员页面收集或展示。</view>
  </view>

  <view class="version">21纪事本 v1.0</view>
</view>
