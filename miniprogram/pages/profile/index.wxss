.profile-hero {
  padding: 46rpx 30rpx 38rpx;
  border-radius: 28rpx;
  color: #fff;
  text-align: center;
  background:
    radial-gradient(circle at 80% 10%, rgba(216, 182, 111, 0.32), transparent 30%),
    #201447;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 130rpx;
  margin: auto;
  border: 4rpx solid #d391ff;
  border-radius: 50%;
  color: #e9cd98;
  font-family: serif;
  font-size: 45rpx;
  font-weight: 700;
}

.name {
  margin-top: 20rpx;
  font-size: 35rpx;
  font-weight: 700;
}

.role {
  margin-top: 9rpx;
  color: #e2c58d;
  font-size: 21rpx;
}

.organization {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
}

.demo-note,
.menu-card {
  display: flex;
  align-items: center;
}

.demo-note {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #2d2050;
}

.demo-icon,
.menu-icon {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  color: #fff;
  font-family: serif;
}

.demo-icon {
  background: #9b5de5;
}

.demo-title,
.menu-title {
  font-weight: 700;
}

.demo-desc,
.menu-desc {
  margin-top: 5rpx;
  color: #9f97b6;
  font-size: 20rpx;
}

.menu-card {
  margin-bottom: 14rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #1b153b;
}

.menu-icon.gold { background: #9b5de5; }
.menu-icon.green { background: #2f6d5d; }
.menu-icon.blue { background: #346b8c; }
.menu-icon.knowledge { background: linear-gradient(145deg, #7b46c5, #2779c8); }
.menu-icon.assistant { background: linear-gradient(145deg, #c35ef0, #267dd5); font-family: sans-serif; font-size: 20rpx; font-weight: 800; }

.reconnect-button { margin: 18rpx 0; color: #fff; background: linear-gradient(135deg, #a15be8, #377ddd); }
.identity-warning { margin-top: 18rpx; padding: 22rpx; border: 1rpx solid rgba(226, 197, 141, 0.28); border-radius: 18rpx; background: #302542; }
.identity-warning-title { color: #f4deb0; font-weight: 700; }
.identity-warning-text { margin-top: 8rpx; color: #c7bdd4; font-size: 20rpx; line-height: 1.65; }
.ai-card{border-color:rgba(123,228,255,.25)}

.menu-copy {
  flex: 1;
}

.arrow {
  color: #9aa49f;
  font-size: 38rpx;
}

.privacy-card {
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  color: #b1a9c8;
  background: #211943;
}

.privacy-title {
  color: #f2efff;
  font-weight: 700;
}

.privacy-text {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.75;
}

.version {
  padding: 40rpx 0 20rpx;
  color: #80799f;
  text-align: center;
  font-size: 19rpx;
}

.profile-hero {
  border: 1rpx solid rgba(211, 145, 255, 0.32);
  background:
    radial-gradient(circle at 82% 10%, rgba(99, 215, 255, 0.22), transparent 30%),
    linear-gradient(145deg, #6333a5, #224f91);
  box-shadow: 0 20rpx 52rpx rgba(55, 20, 116, 0.32);
}

.profile-hero .avatar {
  border-color: #d391ff;
  color: #edcfff;
  background: rgba(25, 14, 58, 0.28);
  box-shadow: 0 0 34rpx rgba(211, 145, 255, 0.3);
}

.role {
  color: #dcaeff;
}

.demo-note,
.menu-card,
.privacy-card {
  border: 1rpx solid rgba(201, 130, 255, 0.15);
  background: rgba(27, 21, 59, 0.88);
  box-shadow: 0 12rpx 34rpx rgba(4, 4, 22, 0.18);
}

.demo-icon,
.menu-icon.gold,
.menu-icon.green,
.menu-icon.blue {
  background: linear-gradient(145deg, #a65de9, #357fdc);
}

.privacy-title {
  color: #f2efff;
}
