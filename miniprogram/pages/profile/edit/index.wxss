.identity-hero,.notice-card,.form-card,.privacy-note{padding:28rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:24rpx;background:#1b153b}.identity-hero{background:linear-gradient(145deg,#6333a5,#224f91)}.hero-title{margin-top:10rpx;color:#fff;font-size:36rpx;font-weight:800}.hero-desc{margin-top:8rpx;color:#d7c8e8;font-size:20rpx;line-height:1.65}.notice-card,.form-card,.privacy-note{margin-top:20rpx;color:#cfc4df;line-height:1.7}.notice-title{margin-bottom:8rpx;color:#fff;font-size:25rpx;font-weight:800}.field-label{margin:18rpx 0 9rpx;color:#cbbbea}.input,.picker-value{box-sizing:border-box;width:100%;padding:22rpx;border-radius:16rpx;color:#fff;background:#2a2050}.account-row{display:flex;justify-content:space-between;margin-top:22rpx;padding:18rpx;border-radius:14rpx;color:#a9a0ba;background:#15102f}.save-button{margin-top:28rpx;color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd)}.privacy-note{color:#9d94af;font-size:19rpx}
