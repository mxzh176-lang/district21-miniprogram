.detail-hero {
  padding: 34rpx;
  border-radius: 28rpx;
  color: #fff;
}

.tone-green { background: linear-gradient(145deg, #2c6a59, #201447); }
.tone-blue { background: linear-gradient(145deg, #477d9b, #244b64); }
.tone-red { background: linear-gradient(145deg, #c2746d, #7d3834); }
.tone-gold { background: linear-gradient(145deg, #bc8c45, #745020); }
.tone-purple { background: linear-gradient(145deg, #84689b, #4e3a60); }
.tone-teal { background: linear-gradient(145deg, #38817e, #225754); }

.detail-top,
.info-row,
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-top {
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
}

.type {
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
}

.detail-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 118rpx;
  height: 118rpx;
  margin: 46rpx auto 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  font-family: serif;
  font-size: 34rpx;
}

.detail-date {
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  font-size: 21rpx;
}

.detail-title {
  margin-top: 9rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
}

.detail-team {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  text-align: center;
}

.info-card {
  margin-top: 22rpx;
}

.info-row + .info-row {
  margin-top: 18rpx;
}

.label {
  color: #9f97b6;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #3a2f5a;
}

.content-title {
  margin-top: 20rpx;
  color: #c982ff;
  font-weight: 700;
}

.content {
  margin-top: 10rpx;
  color: #b1a9c8;
  line-height: 1.8;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
}

.photo {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 260rpx;
  border-radius: 18rpx;
  color: #fff;
}

.photo-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  font-family: serif;
  font-size: 26rpx;
}

.photo-label {
  margin-top: 14rpx;
  font-size: 23rpx;
}

.watermark {
  position: absolute;
  right: 12rpx;
  bottom: 10rpx;
  color: rgba(255, 255, 255, 0.45);
  font-size: 16rpx;
}

.archive-note {
  margin: 28rpx 0;
  padding: 24rpx;
  border-radius: 18rpx;
  color: #6c7974;
  background: #211943;
  font-size: 21rpx;
  line-height: 1.7;
}
