.archive-hero {
  padding: 36rpx;
  border-radius: 28rpx;
  color: #fff;
  background:
    radial-gradient(circle at 83% 12%, rgba(216, 182, 111, 0.3), transparent 29%),
    #201447;
}

.hero-kicker {
  color: #d391ff;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 13rpx;
  font-family: serif;
  font-size: 46rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.65);
}

.archive-stats {
  display: flex;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.archive-stats view {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.big {
  font-size: 34rpx;
  font-weight: 700;
}

.archive-stats text + text {
  margin-top: 3rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 18rpx;
}

.team-scroll {
  margin: 24rpx 0;
  white-space: nowrap;
}

.team-filters {
  display: inline-flex;
  gap: 12rpx;
}

.team-filter {
  padding: 12rpx 23rpx;
  border-radius: 999rpx;
  color: #65736e;
  background: #211943;
  font-size: 21rpx;
}

.team-filter.active {
  color: #fff;
  background: #201447;
}

.event-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 26rpx;
  background: #1b153b;
  box-shadow: 0 12rpx 32rpx rgba(18, 59, 50, 0.06);
}

.event-cover {
  height: 300rpx;
  padding: 24rpx;
  box-sizing: border-box;
  color: #fff;
}

.tone-green { background: linear-gradient(145deg, #2c6a59, #201447); }
.tone-blue { background: linear-gradient(145deg, #477d9b, #244b64); }
.tone-red { background: linear-gradient(145deg, #c2746d, #7d3834); }
.tone-gold { background: linear-gradient(145deg, #bc8c45, #745020); }
.tone-purple { background: linear-gradient(145deg, #84689b, #4e3a60); }
.tone-teal { background: linear-gradient(145deg, #38817e, #225754); }

.cover-top,
.event-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-type,
.photo-count {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.15);
  font-size: 19rpx;
}

.cover-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin: 48rpx auto 0;
  border: 3rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 50%;
  font-family: serif;
  font-size: 29rpx;
}

.cover-caption {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.58);
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.event-copy {
  padding: 26rpx;
}

.event-date {
  color: #a27630;
  font-size: 20rpx;
}


.event-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.event-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 13rpx;
  color: #64736d;
  font-size: 22rpx;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.event-meta {
  margin-top: 20rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid rgba(201,130,255,.16);
  color: #87928e;
  font-size: 20rpx;
}
