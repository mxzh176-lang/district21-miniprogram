.form-hero{padding:30rpx;border-bottom:6rpx solid #d2a63d;border-radius:20rpx;color:#fff;background:#153c4c}.form-title{font-size:34rpx;font-weight:800}.form-desc{margin-top:9rpx;color:#c4d7dc;font-size:21rpx;line-height:1.55}.form-card{margin-top:20rpx;padding:25rpx;border:1rpx solid rgba(201,130,255,.16);border-radius:16rpx;background:#1b153b}.label{margin:26rpx 0 10rpx;color:#e8c767;font-size:21rpx;font-weight:700}.label:first-child{margin-top:0}.picker-field,.input,.value-field,.metric-name{box-sizing:border-box;width:100%;min-height:76rpx;padding:0 20rpx;border:1rpx solid #40345f;border-radius:8rpx;color:#fff;-webkit-text-fill-color:#fff;background:#241c43;font-size:22rpx}.picker-field,.value-field{display:flex;align-items:center;justify-content:space-between}.picker-field text,.value-field text{color:#aaa3bc}.input{height:76rpx}.value-field input{flex:1;color:#fff;-webkit-text-fill-color:#fff}.metric-name{display:flex;align-items:center}.placeholder{color:#827a97!important;-webkit-text-fill-color:#827a97!important}.thresholds{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-top:10rpx}.thresholds view{padding:13rpx 5rpx;background:#211a3e;text-align:center}.thresholds text,.thresholds .strong{display:block}.thresholds text{color:#8d86a1;font-size:17rpx}.thresholds .strong{margin-top:4rpx;font-size:20rpx}.help{margin-top:8rpx;color:#827b96;font-size:17rpx;line-height:1.45}.textarea{box-sizing:border-box;width:100%;height:170rpx;padding:18rpx;border:1rpx solid #40345f;border-radius:8rpx;color:#fff;-webkit-text-fill-color:#fff;background:#241c43;font-size:22rpx}.requirement{margin-top:18rpx;padding:20rpx;border-left:6rpx solid #42a789;background:#18352f}.requirement .strong,.requirement text{display:block}.requirement .strong{color:#9be0ca;font-size:21rpx}.requirement text{margin-top:7rpx;color:#b8ccc6;font-size:20rpx;line-height:1.6}.submit{height:82rpx;margin-top:24rpx;border:0;border-radius:9rpx;color:#fff;background:#6845a6;font-size:25rpx;font-weight:750;line-height:82rpx}.submit::after{border:0}
