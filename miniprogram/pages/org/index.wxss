.contacts-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 54rpx 20rpx 24rpx;
}

.scope-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(123, 228, 255, .22);
  border-radius: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, rgba(33, 24, 73, .96), rgba(21, 50, 90, .9));
}

.scope-kicker {
  color: #7be4ff;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.scope-name {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.scope-switch {
  padding: 10rpx 17rpx;
  border-radius: 999rpx;
  color: #dff8ff;
  background: rgba(123, 228, 255, .14);
  font-size: 20rpx;
  font-weight: 800;
}

.member-hero {
  padding: 30rpx;
  border-radius: 27rpx;
  color: #fff;
  background:
    radial-gradient(circle at 85% 8%, rgba(216, 182, 111, 0.3), transparent 28%),
    #201447;
}

.hero-kicker {
  color: #d391ff;
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-family: serif;
  font-size: 41rpx;
  font-weight: 700;
}
.hero-heading{display:flex;align-items:center;justify-content:space-between}

.hero-desc {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 19rpx;
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 21rpx;
  padding: 0 20rpx;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.12);
}

.add-member {
  width:72rpx;height:72rpx;margin:0;padding:0;
  border: 1rpx solid rgba(227, 199, 142, .55);
  border-radius: 999rpx;
  color: #f2d99d;
  background: rgba(255, 255, 255, .1);
  font-size: 40rpx;
  line-height: 68rpx;
}

.search-icon {
  margin-right: 10rpx;
  color: #e3c78e;
  font-size: 30rpx;
}

.search-box input {
  flex: 1;
  height: 70rpx;
  color: #fff;
  font-size: 20rpx;
}

.team-scroll {
  margin: 18rpx 0 12rpx;
  white-space: nowrap;
}

.team-filters {
  display: inline-flex;
  gap: 10rpx;
}

.team-filter {
  padding: 10rpx 19rpx;
  border-radius: 999rpx;
  color: #aaa2bf;
  background: #211943;
  font-size: 19rpx;
}

.team-filter.active {
  color: #fff;
  background: #201447;
}

.contacts-scroll {
  height: calc(100vh - 390rpx);
}

.contacts-bottom-space {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.group-letter {
  padding: 12rpx 4rpx 7rpx;
  color: #c982ff;
  font-size: 25rpx;
  font-weight: 700;
}

.contact-card {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  padding: 18rpx;
  overflow: hidden;
  border-radius: 19rpx;
  background: #1b153b;
}

.team-ribbon {
  position: absolute;
  left: 0;
  top: 0;
  width: 8rpx;
  height: 100%;
  background: #7be4ff;
}

.avatar {
  display: flex;
  flex: 0 0 68rpx;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  color: #fff;
  font-family: serif;
  font-size: 26rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-green { background: linear-gradient(145deg, #2ed18b, #1c6c54); }
.avatar-red { background: linear-gradient(145deg, #ff6a82, #8f273b); }
.avatar-blue { background: linear-gradient(145deg, #52b6ff, #245e9f); }
.avatar-purple { background: linear-gradient(145deg, #bd76ff, #6333a5); }
.avatar-gold { background: linear-gradient(145deg, #e3c78e, #9c6e2e); }

.contact-copy {
  flex: 1;
  min-width: 0;
}

.name-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.name {
  font-size: 26rpx;
  font-weight: 700;
}

.identity {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: baseline;
  gap: 10rpx;
}

.name {
  flex-shrink: 0;
}

.company-inline {
  overflow: hidden;
  color: #e1baff;
  font-size: 20rpx;
  font-weight:600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-name {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #f4eaff;
  background: rgba(201, 130, 255, 0.16);
  font-size: 17rpx;
  font-weight: 700;
}

.position {
  margin-top: 4rpx;
  color: #60716b;
  font-size: 18rpx;
}

.member-info {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.member-info text {
  max-width: 100%;
  padding: 5rpx 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #d7cfff;
  background: rgba(255, 255, 255, 0.08);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-chip {
  flex: none;
  margin-left: 8rpx;
  padding: 9rpx 14rpx;
  border: 1rpx solid rgba(123, 228, 255, .38);
  border-radius: 999rpx;
  color: #7be4ff;
  background: rgba(123, 228, 255, .11);
  font-size: 18rpx;
  font-weight: 800;
}

.company {
  overflow: hidden;
  margin-top: 4rpx;
  color: #9189a9;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resource {
  overflow: hidden;
  margin-top: 4rpx;
  color: #c982ff;
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-arrow {
  margin-left: 10rpx;
  color: #b0b8b4;
  font-size: 32rpx;
}

.alphabet-rail {
  position: fixed;
  top: 330rpx;
  right: 5rpx;
  z-index: 10;
  width: 44rpx;
  text-align: center;
}

.alphabet-letter {
  height: 27rpx;
  color: #59716a;
  font-size: 17rpx;
  line-height: 27rpx;
  transition: all 0.15s;
}

.alphabet-letter.disabled {
  color: #c6ccc9;
}

.alphabet-letter.active {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  transform: scale(1.25);
  border-radius: 50%;
  background: #9b5de5;
}

.letter-bubble {
  position: fixed;
  top: 48%;
  right: 76rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  color: #fff;
  background: rgba(92, 47, 156, 0.9);
  font-size: 42rpx;
  font-weight: 700;
  pointer-events: none;
}

.member-hero {
  border: 1rpx solid rgba(211, 145, 255, 0.32);
  background:
    radial-gradient(circle at 88% 8%, rgba(99, 215, 255, 0.22), transparent 29%),
    linear-gradient(145deg, #6333a5, #224f91);
  box-shadow: 0 20rpx 52rpx rgba(55, 20, 116, 0.32);
}

.hero-kicker,
.search-icon,
.group-letter {
  color: #7be4ff;
}

.search-box,
.add-member {
  border: 1rpx solid rgba(229, 193, 255, 0.2);
  background: rgba(12, 10, 38, 0.22);
}

.add-member {
  color: #edcfff;
}

.team-filter {
  border: 1rpx solid rgba(201, 130, 255, 0.12);
  color: #aaa2bf;
  background: rgba(31, 24, 65, 0.86);
}

.team-filter.active {
  background: linear-gradient(135deg, #a15be8, #377ddd);
}

.contact-card {
  border: 1rpx solid rgba(201, 130, 255, 0.15);
  background: rgba(27, 21, 59, 0.88);
  box-shadow: 0 12rpx 34rpx rgba(4, 4, 22, 0.2);
}
.contact-card{padding:20rpx}.position{color:#aaa2bf}.search-box input{color:#fff;background:transparent}.search-box{background:rgba(12,10,38,.3)}

.contact-card-green { border-color: rgba(36, 209, 143, .42); }
.contact-card-red { border-color: rgba(255, 94, 122, .42); }
.contact-card-blue { border-color: rgba(79, 176, 255, .42); }
.contact-card-purple { border-color: rgba(185, 110, 255, .42); }
.contact-card-gold { border-color: rgba(227, 199, 142, .42); }
.contact-card-green .team-ribbon,
.contact-card-green .team-name { background: rgba(36, 209, 143, .18); color: #a6f6d6; }
.contact-card-red .team-ribbon,
.contact-card-red .team-name { background: rgba(255, 94, 122, .2); color: #ffc0ca; }
.contact-card-blue .team-ribbon,
.contact-card-blue .team-name { background: rgba(79, 176, 255, .18); color: #c2e6ff; }
.contact-card-purple .team-ribbon,
.contact-card-purple .team-name { background: rgba(185, 110, 255, .2); color: #ead1ff; }
.contact-card-gold .team-ribbon,
.contact-card-gold .team-name { background: rgba(227, 199, 142, .2); color: #ffe5ae; }

.alphabet-letter {
  color: #8f86ad;
}

.alphabet-letter.active {
  background: linear-gradient(135deg, #b15df0, #4f8be4);
  box-shadow: 0 0 22rpx rgba(201, 130, 255, 0.54);
}

/* Feishu-style refresh */
.contacts-page {
  background: #f7f8fa;
  color: #1f2329;
}

.scope-card,
.member-hero,
.contact-card {
  border: 1rpx solid #eef0f5;
  color: #1f2329;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(31, 35, 41, .06);
}

.scope-kicker,
.hero-kicker,
.group-letter,
.search-icon {
  color: #1456f0;
}

.scope-name,
.hero-title,
.name {
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.scope-switch,
.team-filter.active,
.edit-chip {
  color: #1456f0;
  background: #eff4ff;
}

.member-hero {
  background:
    radial-gradient(circle at 88% 8%, rgba(20, 86, 240, .11), transparent 30%),
    #fff;
}

.add-member {
  border: 0;
  color: #fff;
  background: #1456f0;
}

.search-box {
  border: 1rpx solid #e8eaf0;
  background: #f7f8fa;
}

.search-box input {
  color: #1f2329;
}

.team-filter {
  border: 1rpx solid #e8eaf0;
  color: #646a73;
  background: #fff;
}

.team-filter.active {
  border-color: #d0d7ff;
}

.position,
.company,
.contact-arrow {
  color: #646a73;
}

.member-info text,
.team-name {
  color: #1456f0;
  background: #eff4ff;
}

.edit-chip {
  border-color: #d0d7ff;
}

.contact-card-green,
.contact-card-red,
.contact-card-blue,
.contact-card-purple,
.contact-card-gold {
  border-color: #eef0f5;
}

.contact-card-green .team-ribbon { background: #14c9c9; }
.contact-card-red .team-ribbon { background: #f54a45; }
.contact-card-blue .team-ribbon { background: #3370ff; }
.contact-card-purple .team-ribbon { background: #7b7df7; }
.contact-card-gold .team-ribbon { background: #f59e0b; }

.alphabet-letter {
  color: #8f959e;
}

.alphabet-letter.active,
.letter-bubble {
  background: #1456f0;
  box-shadow: 0 8rpx 20rpx rgba(20, 86, 240, .24);
}
