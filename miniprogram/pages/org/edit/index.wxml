<view class="page">
  <view class="notice" wx:if="{{canManage}}">仅录入内部身份和岗位所需的最少资料，不填写企业、地址、电话或其他非必要信息。</view>
  <view class="notice denied" wx:else>当前账号没有录入权限。</view>
  <view class="form-card" wx:if="{{canManage}}">
    <view class="avatar-editor" bindtap="chooseAvatar">
      <image wx:if="{{form.avatarUrl}}" src="{{form.avatarUrl}}" mode="aspectFill" />
      <view wx:else>上传头像</view>
      <text>点击修改头像</text>
    </view>
    <view class="field"><text class="label">姓名</text><input class="member-input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="狮友姓名" placeholder-class="member-placeholder" cursor-color="#7be4ff" always-embed="{{true}}" /></view>
    <view class="field"><text class="label">所属服务队</text><picker range="{{teams}}" range-key="name" value="{{teamIndex}}" bindchange="onTeamChange"><view class="picker">{{teams[teamIndex].name}}</view></picker></view>
    <view class="field"><text class="label">岗位</text><input class="member-input" value="{{form.position}}" data-field="position" bindinput="onInput" placeholder="例如：新闻宣传主席" placeholder-class="member-placeholder" cursor-color="#7be4ff" always-embed="{{true}}" /></view>
    <button class="save-button" bindtap="save">保存狮友资料</button>
  </view>
</view>
