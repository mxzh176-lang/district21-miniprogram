.page{min-height:100vh;padding:28rpx;background:#0b1024;box-sizing:border-box}.notice{padding:22rpx;border-left:6rpx solid #9b5de5;border-radius:14rpx;background:#2a2048;color:#ddcdec;line-height:1.6}.notice.denied{border-color:#c45b5b;background:#351b34;color:#ffb7c2}
.form-card{margin-top:22rpx;padding:30rpx;border:1rpx solid rgba(201,130,255,.2);border-radius:24rpx;background:#1b153b}.field+.field{margin-top:26rpx}.label{display:block;margin-bottom:12rpx;color:#f2efff;font-weight:700}
input,.picker,textarea{width:100%;padding:22rpx;border:1rpx solid rgba(211,145,255,.3);border-radius:14rpx;color:#fff;background:#100d29;box-sizing:border-box}textarea{min-height:150rpx}.save-button{margin-top:34rpx;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#a15be8,#377ddd)}
.notice{color:#ddcdec;background:#2a2048}.avatar-editor{display:flex;flex-direction:column;align-items:center;margin-bottom:28rpx;color:#b8aecb}.avatar-editor image,.avatar-editor view{display:flex;align-items:center;justify-content:center;width:150rpx;height:150rpx;margin-bottom:10rpx;border:3rpx solid #d391ff;border-radius:50%;color:#e8c9ff;background:#302255}
