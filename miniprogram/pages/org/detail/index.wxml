<view class="page" wx:if="{{member._id}}">
  <view class="profile-card">
    <view class="avatar avatar-{{member.avatarTone}}">
      <image wx:if="{{member.avatarUrl}}" class="avatar-image" src="{{member.avatarUrl}}" mode="aspectFill" />
      <text wx:else>{{member.initial}}</text>
    </view>
    <view class="name">{{member.name}}</view>
    <view class="position">{{member.position}}</view>
    <view class="team">{{member.team}}</view>
    <button wx:if="{{canManage}}" class="edit-button" bindtap="editMember">编辑资料</button>
  </view>

  <view class="privacy-note">本页仅展示内部成员姓名、所属服务队和岗位，不收集或展示企业、地址、电话等非必要信息。</view>
</view>
