.page{min-height:100vh;padding:28rpx;background:#0b1024;box-sizing:border-box}
.profile-card{padding:38rpx;border:1rpx solid rgba(201,130,255,.2);border-radius:28rpx;background:linear-gradient(145deg,#24154f,#3a2675);color:#fff;text-align:center}
.profile-card-green{border-color:rgba(36,209,143,.46);background:linear-gradient(145deg,#123e37,#1f4f75)}
.profile-card-red{border-color:rgba(255,94,122,.46);background:linear-gradient(145deg,#4a1c3a,#2f1f59)}
.profile-card-blue{border-color:rgba(79,176,255,.46);background:linear-gradient(145deg,#183866,#1f2562)}
.profile-card-purple{border-color:rgba(185,110,255,.46);background:linear-gradient(145deg,#45226f,#25215e)}
.profile-card-gold{border-color:rgba(227,199,142,.46);background:linear-gradient(145deg,#4e361d,#322356)}
.avatar{display:flex;align-items:center;justify-content:center;width:132rpx;height:132rpx;margin:0 auto;border:5rpx solid rgba(223,190,119,.8);border-radius:50%;background:#346b8c;font-size:44rpx;overflow:hidden}
.avatar-green{background:linear-gradient(145deg,#2ed18b,#1c6c54)}
.avatar-red{background:linear-gradient(145deg,#ff6a82,#8f273b)}
.avatar-blue{background:linear-gradient(145deg,#52b6ff,#245e9f)}
.avatar-purple{background:linear-gradient(145deg,#bd76ff,#6333a5)}
.avatar-gold{background:linear-gradient(145deg,#e3c78e,#9c6e2e)}
.avatar-image{width:100%;height:100%}.name{margin-top:18rpx;font-size:40rpx;font-weight:700}.position{margin-top:8rpx;color:#f0d598}.team{margin-top:7rpx;color:rgba(255,255,255,.72)}
.edit-button{width:240rpx;margin:24rpx auto 0;border-radius:999rpx;color:#24154f;background: #1b153b;font-size:25rpx}
.card{margin-top:22rpx;padding:30rpx;border:1rpx solid rgba(201,130,255,.18);border-radius:24rpx;background:#1b153b}.section-title{margin-bottom:20rpx;color:#c982ff;font-size:30rpx;font-weight:700}
.row{display:flex;align-items:flex-start;justify-content:space-between;gap:30rpx;padding:18rpx 0;border-bottom: 1rpx solid rgba(201,130,255,.14);color:#e8e2f8;line-height:1.6;text-align:right}
.row:last-child{border-bottom:0}
.label{flex:0 0 150rpx;color:#9f97b6;text-align:left}.call-button{margin-top:24rpx;border-radius:999rpx;color:#fff;background:#24154f}
.privacy-note{margin-top:22rpx;padding:24rpx;border-radius:18rpx;color:#786b54;background:#eee7da;text-align:center}
