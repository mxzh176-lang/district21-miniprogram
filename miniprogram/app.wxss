page {
  min-height: 100%;
  background: #f7f8fa;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #eef0f5;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(31, 35, 41, 0.06);
}

.section-title {
  margin: 36rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.muted {
  color: #646a73;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  color: #1456f0;
  background: #e8f0ff;
  font-size: 22rpx;
}

.primary-button {
  color: #fff;
  background: linear-gradient(135deg, #3370ff, #1456f0);
  border-radius: 18rpx;
  font-weight: 600;
}

.secondary-button {
  color: #1456f0;
  background: #e8f0ff;
  border-radius: 18rpx;
}

.danger-button {
  color: #a0372d;
  background: #fae8e4;
  border-radius: 18rpx;
}

.empty {
  padding: 90rpx 30rpx;
  text-align: center;
  color: #8f959e;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #1f2329;
  font-size: 25rpx;
  font-weight: 600;
}

.input,
.textarea,
.picker {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(183, 124, 237, 0.22);
  border-radius: 16rpx;
  color: #1f2329;
  background: #fff;
}

.textarea {
  min-height: 180rpx;
}
