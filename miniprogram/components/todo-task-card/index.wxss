.task-card {
  display: flex;
  min-height: 188rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  border: 1rpx solid #7987aa;
  border-radius: 24rpx;
  background: linear-gradient(105deg, rgba(73, 85, 123, .72), rgba(13, 20, 48, .97) 30%, rgba(11, 18, 42, .98));
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 18, .22);
}

.task-card.tone-service { border-color: #11b86d; background: linear-gradient(105deg, rgba(0, 132, 77, .88), rgba(13, 20, 48, .97) 30%, rgba(11, 18, 42, .98)); }
.task-card.tone-meeting { border-color: #188bff; background: linear-gradient(105deg, rgba(0, 82, 172, .9), rgba(13, 20, 48, .97) 30%, rgba(11, 18, 42, .98)); }
.task-card.tone-birthday { border-color: #b247ef; background: linear-gradient(105deg, rgba(111, 29, 167, .9), rgba(13, 20, 48, .97) 30%, rgba(11, 18, 42, .98)); }
.task-card.tone-social { border-color: #ff930e; background: linear-gradient(105deg, rgba(190, 91, 0, .92), rgba(13, 20, 48, .97) 30%, rgba(11, 18, 42, .98)); }
.task-card.tone-visit { border-color: #f04555; background: linear-gradient(105deg, rgba(162, 31, 53, .9), rgba(13, 20, 48, .97) 30%, rgba(11, 18, 42, .98)); }
.task-card.tone-training { border-color: #15b9c6; background: linear-gradient(105deg, rgba(10, 123, 137, .9), rgba(13, 20, 48, .97) 30%, rgba(11, 18, 42, .98)); }

.category-rail {
  display: flex;
  flex: 0 0 112rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 8rpx;
  border-right: 1rpx solid rgba(255, 255, 255, .13);
  text-align: center;
}

.category-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border: 2rpx solid rgba(255, 255, 255, .68);
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.category-glyph {
  display: block;
  font-size: 36rpx;
  line-height: 1;
  transform-origin: 50% 82%;
}

.icon-service { background: #ecf8f1; }
.icon-meeting { background: #edf4ff; }
.icon-birthday { background: #fff0f7; }
.icon-social { background: #fff6e8; }
.icon-visit { background: #fff0f0; }
.icon-training { background: #eaf8fa; }

.icon-service .category-glyph { animation: sprout-sway 2.2s ease-in-out infinite; }
.icon-meeting .category-glyph { animation: notice-shake 2.4s ease-in-out infinite; }
.icon-birthday .category-glyph { animation: cake-bounce 1.8s ease-in-out infinite; }
.icon-social .category-glyph { animation: social-float 2s ease-in-out infinite; }
.icon-visit .category-glyph { animation: care-beat 1.7s ease-in-out infinite; }
.icon-training .category-glyph { animation: cap-lift 2.2s ease-in-out infinite; }
.icon-default .category-glyph { animation: pin-pulse 2.2s ease-in-out infinite; }

.cake-spark {
  position: absolute;
  top: 3rpx;
  color: #ffad24;
  font-size: 15rpx;
  line-height: 1;
  animation: cake-sparkle 1.4s ease-in-out infinite;
}

.cake-spark-left { left: 4rpx; }
.cake-spark-right { right: 4rpx; animation-delay: .7s; }
.completed-icon { color: #fff; }
.done .category-glyph,.done .cake-spark { animation: none; }

@keyframes cake-bounce {
  0%,100% { transform: translateY(0) scale(1); }
  45% { transform: translateY(-5rpx) scale(1.06); }
  60% { transform: translateY(-2rpx) scale(.98); }
}

@keyframes cake-sparkle {
  0%,100% { opacity: .2; transform: scale(.65) rotate(0deg); }
  50% { opacity: 1; transform: scale(1.15) rotate(25deg); }
}

@keyframes sprout-sway {
  0%,100% { transform: rotate(-4deg); }
  50% { transform: rotate(6deg) translateY(-2rpx); }
}

@keyframes notice-shake {
  0%,72%,100% { transform: rotate(0deg); }
  78% { transform: rotate(-8deg); }
  84% { transform: rotate(8deg); }
  90% { transform: rotate(-4deg); }
}

@keyframes social-float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-4rpx); }
}

@keyframes care-beat {
  0%,100% { transform: scale(1); }
  20% { transform: scale(1.12); }
  38% { transform: scale(1); }
  55% { transform: scale(1.08); }
}

@keyframes cap-lift {
  0%,100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-4rpx) rotate(-4deg); }
}

@keyframes pin-pulse {
  0%,100% { transform: scale(1); opacity: .85; }
  50% { transform: scale(1.08); opacity: 1; }
}

.category-name {
  margin-top: 13rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
}

.task-body {
  flex: 1;
  min-width: 0;
  padding: 23rpx 18rpx 21rpx 22rpx;
}

.title {
  overflow: hidden;
  color: #f7f5ff;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-row {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 12rpx;
  color: #aaa6bd;
  font-size: 20rpx;
  line-height: 1.3;
}

.info-key {
  flex: 0 0 62rpx;
  margin-right: 8rpx;
  color: #7d85a3;
  font-weight: 700;
}
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.date-text { color: #f4f1fb; font-weight: 800; }

.team-label {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  margin-top: 13rpx;
  padding: 7rpx 13rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #e5e0f1;
  background: rgba(44, 51, 90, .86);
  font-size: 19rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-label-dot {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #7987aa;
}

.tone-service .team-label-dot { background: #11b86d; }
.tone-meeting .team-label-dot { background: #188bff; }
.tone-birthday .team-label-dot { background: #b247ef; }
.tone-social .team-label-dot { background: #ff930e; }
.tone-visit .team-label-dot { background: #f04555; }
.tone-training .team-label-dot { background: #15b9c6; }

.task-side {
  display: flex;
  flex: 0 0 142rpx;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 35rpx 13rpx 30rpx 0;
}

.countdown {
  color: #9ca8c7;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.15;
  text-align: center;
  text-shadow: 0 0 16rpx rgba(255, 255, 255, .07);
  white-space: nowrap;
}

.tone-service .countdown { color: #18c77a; }
.tone-meeting .countdown { color: #2796ff; }
.tone-birthday .countdown { color: #c257ff; }
.tone-social .countdown { color: #ff9b1b; }
.tone-visit .countdown { color: #ff5262; }
.tone-training .countdown { color: #20c7d3; }

.countdown-value {
  margin: 0 4rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.countdown-prefix,
.countdown-unit { font-size: 21rpx; }
.countdown.compact .countdown-value { font-size: 22rpx; }

.check-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
}

.check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #727a98;
  border-radius: 50%;
  color: #081526;
  background: rgba(7, 12, 33, .7);
  font-size: 25rpx;
  font-weight: 900;
}

.check-box.checked {
  border-color: #20b77d;
  color: #07152a;
  background: #20b77d;
}

.check-box.disabled { opacity: .38; }
.task-card.done { opacity: .58; filter: saturate(.65); }
.task-card.done .title { text-decoration: line-through; }
.task-card.done .task-side { justify-content: center; }

.compact-card {
  min-height: 154rpx;
  margin-bottom: 12rpx;
  border-radius: 22rpx;
}

.compact-card .category-rail {
  flex-basis: 94rpx;
  padding: 16rpx 6rpx;
}

.compact-card .category-icon {
  width: 52rpx;
  height: 52rpx;
  font-size: 24rpx;
}

.compact-card .category-name {
  margin-top: 9rpx;
  font-size: 18rpx;
}

.compact-card .task-body {
  padding: 18rpx 14rpx 16rpx 18rpx;
}

.compact-card .title {
  font-size: 25rpx;
}

.compact-card .info-row {
  margin-top: 8rpx;
  font-size: 18rpx;
}

.compact-card .team-label {
  margin-top: 9rpx;
  padding: 6rpx 11rpx;
  font-size: 17rpx;
}

.compact-card .task-side {
  flex-basis: 118rpx;
  padding: 28rpx 10rpx 22rpx 0;
}

.compact-card .countdown-value {
  font-size: 34rpx;
}

.compact-card .countdown-prefix,
.compact-card .countdown-unit {
  font-size: 18rpx;
}

/* Feishu-style refresh */
.task-card,
.task-card.tone-service,
.task-card.tone-meeting,
.task-card.tone-birthday,
.task-card.tone-social,
.task-card.tone-visit,
.task-card.tone-training {
  border: 1rpx solid #eef0f5;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(31, 35, 41, .06);
}

.category-rail {
  border-right: 1rpx solid #eef0f5;
  background: #f7f8fa;
}

.category-icon {
  border: 0;
  color: #1456f0;
}

.category-name,
.title {
  color: #1f2329;
}

.info-row,
.info-icon {
  color: #646a73;
}

.date-text { color: #1f2329; }

.team-label {
  color: #1456f0;
  background: #eff4ff;
}

.countdown,
.tone-service .countdown,
.tone-meeting .countdown,
.tone-birthday .countdown,
.tone-social .countdown,
.tone-visit .countdown,
.tone-training .countdown {
  color: #1456f0;
  text-shadow: none;
}

.check-box {
  border-color: #c9cdd4;
  color: #fff;
  background: #fff;
}

.check-box.checked {
  border-color: #0c9b6b;
  color: #fff;
  background: #0c9b6b;
}

.task-card.done {
  opacity: .72;
  filter: none;
}
