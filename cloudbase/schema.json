      "name": "organization",
      "description": "组织树：联会、代表处、协作区、服务队，支持无限层级。",
      "indexes": [
        ["type", "status"],
        ["parentId", "status"],
        ["ancestorIds", "status"],
        ["level", "sortOrder"]
      ],
      "fields": {
        "id": "string",
        "name": "string",
        "shortName": "string",
        "type": "federation | office | region | team",
        "parentId": "string | null",
        "ancestorIds": "string[]",
        "level": "number",
        "pathName": "string",
        "status": "active | inactive | archived",
        "sortOrder": "number",
        "createdAt": "Date",
        "updatedAt": "Date",
        "deletedAt": "Date | null"
      }
    },
    {
      "name": "user",
      "description": "用户主表，保留 openid/unionid 与基本资料。",
      "indexes": [
        ["openid"],
        ["unionid"],
        ["status"],
        ["defaultOrganizationId"]
      ],
      "fields": {
        "id": "string",
        "openid": "string",
        "unionid": "string",
        "name": "string",
        "avatar": "string",
        "phone": "string",
        "status": "pending | active | disabled",
        "defaultOrganizationId": "string",
        "profileCompleted": "boolean",
        "memberCode": "string",
        "createdAt": "Date",
        "updatedAt": "Date",
        "lastLoginAt": "Date"
      }
    },
    {
      "name": "user_role",
      "description": "用户角色表，一个用户可以在多个组织拥有多个角色。",
      "indexes": [
        ["userId", "status"],
        ["organizationId", "role", "status"],
        ["userId", "organizationId", "role"]
      ],
      "fields": {
        "id": "string",
        "userId": "string",
        "organizationId": "string",
        "role": "super_admin | federation_admin | office_admin | region_admin | area_admin | team_admin | role_manager | member",
        "status": "active | inactive",
        "grantedBy": "string",
        "grantedAt": "Date",
        "expiresAt": "Date | null",
        "createdAt": "Date",
        "updatedAt": "Date"
      }
